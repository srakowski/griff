<!-- A color field's picker: saturation and value in the square, hue and alpha in the strips, the hex, the palette and recent colors. -->
<UserControl x:Class="Griff.Editor.Features.Inspector.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:Griff.Editor.Features.Inspector"
             xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:ColorPicker}"
             Width="248">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="Visible" />
        <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />

        <!-- A color to pick: ringed when it's the one picked -->
        <DataTemplate x:Key="SwatchTemplate" DataType="inspector:ColorSwatch">
            <Button Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0"
                    Margin="0,0,3,3"
                    Command="{Binding PickCommand}"
                    Cursor="Hand"
                    Tag="color:pick"
                    ToolTip="{Binding Hex}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="3" Padding="1">
                            <Border Background="{StaticResource Brush.Checker}" CornerRadius="2">
                                <Border Background="{Binding Brush}" CornerRadius="2" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="SwatchPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Border Padding="8" Style="{StaticResource Style.Border.Flyout}">
        <StackPanel>
            <!-- Saturation across, value up, for the picked hue -->
            <Grid x:Name="Square"
                  Height="132"
                  Background="Transparent"
                  Cursor="Cross"
                  MouseLeftButtonDown="OnStripDown"
                  MouseLeftButtonUp="OnStripUp"
                  MouseMove="OnStripMove"
                  SizeChanged="OnSizeChanged"
                  Tag="color:square"
                  ToolTip="Across: how strong. Up: how bright.">
                <Border Background="{Binding HueBrush}" CornerRadius="2" />
                <Border Background="White" CornerRadius="2">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Black" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Border Background="Black" CornerRadius="2">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SquareThumb" Width="11" Height="11" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="2" Opacity="0.8" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Hue round the color wheel -->
            <Grid x:Name="HueStrip"
                  Height="12"
                  Margin="0,8,0,0"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseLeftButtonDown="OnStripDown"
                  MouseLeftButtonUp="OnStripUp"
                  MouseMove="OnStripMove"
                  SizeChanged="OnSizeChanged"
                  Tag="color:hue"
                  ToolTip="Hue">
                <Border CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FF0000" />
                            <GradientStop Offset="0.1667" Color="#FFFF00" />
                            <GradientStop Offset="0.3333" Color="#00FF00" />
                            <GradientStop Offset="0.5" Color="#00FFFF" />
                            <GradientStop Offset="0.6667" Color="#0000FF" />
                            <GradientStop Offset="0.8333" Color="#FF00FF" />
                            <GradientStop Offset="1" Color="#FF0000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="6" Height="16" Canvas.Top="-2" BorderBrush="White" BorderThickness="2" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" Opacity="0.8" ShadowDepth="0" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Alpha: see-through to solid -->
            <Grid x:Name="AlphaStrip"
                  Height="12"
                  Margin="0,8,0,0"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseLeftButtonDown="OnStripDown"
                  MouseLeftButtonUp="OnStripUp"
                  MouseMove="OnStripMove"
                  SizeChanged="OnSizeChanged"
                  Tag="color:alpha"
                  ToolTip="How solid: see-through on the left">
                <Border Background="{StaticResource Brush.Checker}" CornerRadius="2" />
                <Border Background="{Binding SolidBrush}" CornerRadius="2">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="AlphaThumb" Width="6" Height="16" Canvas.Top="-2" BorderBrush="White" BorderThickness="2" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" Opacity="0.8" ShadowDepth="0" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- The color, and its hex to type -->
            <DockPanel Margin="0,10,0,0">
                <Border Width="32" Height="22"
                        Margin="0,0,6,0"
                        Background="{StaticResource Brush.Checker}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Small}"
                        DockPanel.Dock="Left">
                    <Border Background="{Binding Brush}" CornerRadius="1" />
                </Border>
                <controls:CommitTextBox FontFamily="{StaticResource Font.Mono}" Tag="color:hex" Text="{Binding Hex}" />
            </DockPanel>

            <!-- The Sprite Painter's palette -->
            <DockPanel Margin="0,12,0,6">
                <ComboBox MinWidth="96"
                          DockPanel.Dock="Right"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Palettes}"
                          SelectedItem="{Binding SelectedPalette}"
                          Tag="color:palette"
                          ToolTip="The palette, shared with the Sprite Painter" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Overline}" Text="Palette" />
            </DockPanel>
            <ItemsControl ItemTemplate="{StaticResource SwatchTemplate}" ItemsPanel="{StaticResource SwatchPanel}" ItemsSource="{Binding Swatches}" Tag="color:swatches" />

            <!-- Colors picked lately, in any color field -->
            <TextBlock Margin="0,8,0,6" Style="{StaticResource Style.Text.Overline}" Text="Recent" />
            <ItemsControl ItemTemplate="{StaticResource SwatchTemplate}"
                          ItemsPanel="{StaticResource SwatchPanel}"
                          ItemsSource="{Binding Recent}"
                          Tag="color:recent"
                          Visibility="{Binding HasRecent, Converter={StaticResource Visible}}" />
            <TextBlock Style="{StaticResource Style.Text.Caption}"
                       Text="Colors you pick show up here."
                       Visibility="{Binding HasRecent, Converter={StaticResource Hidden}}" />
        </StackPanel>
    </Border>
</UserControl>
