<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Foundation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Number input with a draggable label. Label is optional; vector fields use X/Y/Z. -->
    <Style TargetType="controls:NumberField">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="LabelBrush" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NumberField">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Input.Background}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Small}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock x:Name="PART_Label"
                                       Padding="6,0,2,0"
                                       VerticalAlignment="Stretch"
                                       Background="Transparent"
                                       Cursor="SizeWE"
                                       DockPanel.Dock="Left"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding LabelBrush}"
                                       Text="{TemplateBinding Label}"
                                       ToolTip="Drag to change. Shift: fine, Ctrl: coarse." />
                            <TextBox x:Name="PART_Input"
                                     MinHeight="0"
                                     Padding="2,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource Font.Mono}"
                                     IsUndoEnabled="False"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
