<UserControl x:Class="Griff.Editor.Features.Rhythm.ChartPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rhythm="clr-namespace:Griff.Editor.Features.Rhythm"
             xmlns:theme="clr-namespace:Griff.Editor.Themes"
             xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=rhythm:ChartPanel}"
             d:DesignHeight="260" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="Worded" TargetType="Button" BasedOn="{StaticResource Style.Button.Toolbar}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="WordedToggle" TargetType="ToggleButton" BasedOn="{StaticResource Style.ToggleButton.Toolbar}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,4,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Toolbar: which chart and difficulty; play, record and stop; the grid and how takes go in; the offset; undo -->
        <Border DockPanel.Dock="Top"
                Padding="4,2"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <ComboBox Width="120"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ChartNames}"
                          SelectedItem="{Binding ChartName, Mode=TwoWay}"
                          Tag="chart:chart"
                          ToolTip="The chart: a table of notes (Beat, Lane, Hold, Difficulty). Selecting Note Lanes shows theirs" />
                <ComboBox Width="80"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Difficulties}"
                          SelectedItem="{Binding Difficulty, Mode=TwoWay}"
                          Tag="chart:difficulty"
                          ToolTip="The difficulty to record and edit; the others' notes show faintly behind" />
                <Separator Style="{StaticResource Style.Separator.Vertical}" />
                <Button x:Name="PlayButton" Style="{StaticResource Worded}" Tag="chart:play" ToolTip="Play from the playhead, a tick on each note (Space); again to stop">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PlayIcon" Foreground="{DynamicResource Brush.Status.Success}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
                        <TextBlock x:Name="PlayText" Margin="4,0,2,0" VerticalAlignment="Center" Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" Style="{StaticResource Worded}" Tag="chart:record" ToolTip="Record a take from the playhead: tap the lanes' keys or buttons along to the song (R); again, or Space, to stop and put it in">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource Brush.Status.Error}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Record}" />
                        <TextBlock x:Name="RecordText" Margin="4,0,2,0" VerticalAlignment="Center" Text="Record" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartButton" Style="{StaticResource Style.Button.Toolbar}" Tag="chart:start" ToolTip="Back to the start (Home)">
                    <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.StepOut}" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <TextBlock Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Tag="chart:playhead" Text="{Binding PlayheadText}" />
                <Separator Style="{StaticResource Style.Separator.Vertical}" />
                <TextBlock Style="{StaticResource Label}" Text="Snap" />
                <ComboBox Width="96"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Snaps}"
                          SelectedItem="{Binding Snap, Mode=TwoWay}"
                          Tag="chart:snap"
                          ToolTip="The grid notes snap to as they're recorded, added and moved" />
                <ComboBox Width="80"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding RecordModes}"
                          SelectedItem="{Binding RecordMode, Mode=TwoWay}"
                          Tag="chart:mode"
                          ToolTip="Overdub adds a take to the notes there; Replace takes the difficulty's notes out from where it started to where it stopped first" />
                <ToggleButton Margin="4,0,0,0"
                              Style="{StaticResource WordedToggle}"
                              IsChecked="{Binding Metronome}"
                              Tag="chart:metronome"
                              ToolTip="Click on every beat as it plays and records">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Stopwatch}" />
                        <TextBlock Margin="4,0,2,0" VerticalAlignment="Center" Text="Metronome" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource WordedToggle}"
                              IsChecked="{Binding Ticks}"
                              Tag="chart:ticks"
                              ToolTip="A tick on each note as it plays back">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Tap}" />
                        <TextBlock Margin="4,0,2,0" VerticalAlignment="Center" Text="Ticks" />
                    </StackPanel>
                </ToggleButton>
                <controls:NumberField Width="96"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      IsInteger="True"
                                      Label="Offset ms"
                                      Step="1"
                                      Tag="chart:offset"
                                      Value="{Binding AudioOffset}"
                                      ToolTip="How late you hear the sound, in milliseconds (Bluetooth headphones: 150 to 250): taps count on the beat you heard. It's your audio offset from playing in the editor; a Calibration sets it" />
                <Separator Style="{StaticResource Style.Separator.Vertical}" />
                <Button x:Name="UndoButton" Style="{StaticResource Style.Button.Toolbar}" CommandParameter="{Binding}" Tag="chart:undo" ToolTip="{Binding UndoDescription, StringFormat=Undo {0} (Ctrl+Z), TargetNullValue=Nothing to undo}">
                    <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Undo}" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource Style.Button.Toolbar}" CommandParameter="{Binding}" Tag="chart:redo" ToolTip="{Binding RedoDescription, StringFormat=Redo {0} (Ctrl+Y), TargetNullValue=Nothing to redo}">
                    <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Redo}" />
                </Button>
                <Separator Style="{StaticResource Style.Separator.Vertical}" />
                <TextBlock Style="{StaticResource Label}" Text="Song" />
                <ComboBox Width="140"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding SongNames}"
                          SelectedItem="{Binding Song, Mode=TwoWay}"
                          Tag="chart:song"
                          ToolTip="The song to play and record along to: the lanes' Song, or the music named like the chart" />
                <TextBlock Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Tag="chart:timing" Text="{Binding TimingText}" />
            </WrapPanel>
        </Border>

        <!-- What the chart has, what the last thing done said, and the note picked -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,3">
            <TextBlock DockPanel.Dock="Right"
                       Margin="12,0,0,0"
                       Style="{StaticResource Style.Text.Secondary}"
                       Tag="chart:selected"
                       Text="{Binding SelectedText}" />
            <TextBlock Style="{StaticResource Style.Text.Secondary}"
                       Tag="chart:message"
                       Text="{Binding Message}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Message}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="8,2,8,0"
                   Style="{StaticResource Style.Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Tag="chart:summary"
                   Text="{Binding Summary}"
                   TextTrimming="CharacterEllipsis" />

        <rhythm:ChartTimeline x:Name="Timeline" Tag="chart:timeline" />
    </DockPanel>
</UserControl>
