<controls:ChromeWindow x:Class="Griff.Editor.Shell.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:shell="clr-namespace:Griff.Editor.Shell"
                       mc:Ignorable="d"
                       d:DataContext="{d:DesignInstance Type=shell:MainWindowViewModel}"
                       Title="{Binding Title}"
                       Width="1440" Height="900"
                       MinWidth="800" MinHeight="500"
                       WindowStartupLocation="CenterScreen">

    <controls:ChromeWindow.TitleBarContent>
        <!-- Populated from registered commands by MenuBuilder. -->
        <Menu x:Name="MainMenu" />
    </controls:ChromeWindow.TitleBarContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Toolbar: populated by ToolbarBuilder. -->
        <StackPanel x:Name="Toolbar" Height="36" Margin="6,0" Orientation="Horizontal" />

        <!-- Workspace: tool panel zones around the document area. Splitters are the gutters. -->
        <Grid Grid.Row="1" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="LeftZone" />
            <GridSplitter x:Name="LeftSplitter"
                          Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="BottomRow" Height="240" />
                </Grid.RowDefinitions>

                <TabControl Style="{StaticResource Style.TabControl.Document}">
                    <TabItem Header="{Binding DocumentTitle}">
                        <TextBox Style="{StaticResource Style.TextBox.Code}"
                                 Text="{Binding Documents.Active.Text, UpdateSourceTrigger=PropertyChanged}" />
                    </TabItem>
                </TabControl>

                <GridSplitter x:Name="BottomSplitter"
                              Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <TabControl x:Name="BottomZone" Grid.Row="2" />
            </Grid>

            <GridSplitter x:Name="RightSplitter"
                          Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />
            <TabControl x:Name="RightZone" Grid.Column="4" />
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="10,0">
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource Style.Text.Caption}"
                       Text="{Binding DocumentLocation}" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource Style.Text.Caption}"
                       Text="{Binding Status.Message}" />
        </DockPanel>
    </Grid>
</controls:ChromeWindow>
