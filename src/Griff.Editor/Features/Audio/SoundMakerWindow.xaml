<controls:ChromeWindow x:Class="Griff.Editor.Features.Audio.SoundMakerWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:audio="clr-namespace:Griff.Editor.Features.Audio"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       mc:Ignorable="d"
                       d:DataContext="{d:DesignInstance Type=audio:SoundMakerViewModel}"
                       Title="Sound Maker"
                       Width="860"
                       Height="660"
                       MinWidth="640"
                       MinHeight="480"
                       ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="Visible" />

        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Overline}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- A big, friendly choice: a preset, a mood, a wave -->
        <Style x:Key="Choice" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Surface.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sound effect or music -->
        <DockPanel Margin="16,12,16,0">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="EffectMode" Width="130" Height="28" IsChecked="{Binding IsEffect}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Audio}" />
                        <TextBlock Text="Sound Effect" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="MusicMode" Width="130" Height="28" Margin="4,0,0,0" IsChecked="{Binding IsMusic}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Music}" />
                        <TextBlock Text="Music" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource Style.Text.Secondary}"
                       Text="{Binding Status}" />
        </DockPanel>

        <!-- Sound effects: start from a preset, then shape it -->
        <Grid Grid.Row="1" Margin="16,4,16,0" Visibility="{Binding IsEffect, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PresetPanel">
                    <TextBlock Style="{StaticResource Heading}" Text="Start from" />
                    <ItemsControl ItemsSource="{Binding Presets, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="audio:PresetChoice">
                                <Button Command="{Binding Command}" Content="{Binding Label}" Style="{StaticResource ChoiceButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MutateButton"
                            Margin="0,8,0,4"
                            Command="{Binding MutateCommand}"
                            Style="{StaticResource ChoiceButton}"
                            ToolTip="Nudge every setting a little: like this, but different">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Shuffle}" />
                            <TextBlock Text="Mutate" />
                        </StackPanel>
                    </Button>

                    <TextBlock Style="{StaticResource Heading}" Text="Wave" />
                    <ItemsControl x:Name="WavePanel" ItemsSource="{Binding Waves, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="audio:WaveChoice">
                                <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource Choice}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SettingsPanel" ItemsSource="{Binding Groups, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="audio:SliderGroup">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Sliders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="audio:SliderSetting">
                                            <Grid Height="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Label}" />
                                                <Slider Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Maximum="{Binding Maximum, Mode=OneTime}"
                                                        Minimum="{Binding Minimum, Mode=OneTime}"
                                                        SmallChange="0.01"
                                                        LargeChange="0.1"
                                                        Value="{Binding Value}" />
                                                <TextBlock Grid.Column="2"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource Style.Text.Mono}"
                                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                           Text="{Binding Display}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Music: pick a mood, then a tune -->
        <Grid Grid.Row="1" Margin="16,4,16,0" Visibility="{Binding IsMusic, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="MoodPanel">
                <TextBlock Style="{StaticResource Heading}" Text="Mood" />
                <ItemsControl ItemsSource="{Binding Moods, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="audio:MoodChoice">
                            <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource Choice}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="NewTuneButton"
                        Margin="0,8,0,4"
                        Command="{Binding NewTuneCommand}"
                        Style="{StaticResource ChoiceButton}"
                        ToolTip="Another tune in the same mood">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Shuffle}" />
                        <TextBlock Text="New Tune" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="MusicSettings" Grid.Column="2">
                <TextBlock Style="{StaticResource Heading}" Text="Tune" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Tempo" />
                    <Slider x:Name="TempoSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="60" Maximum="200" SmallChange="1" LargeChange="10" Value="{Binding Tempo, Delay=150}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding Tempo, StringFormat={}{0:0} bpm}" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Bars" />
                    <ComboBox x:Name="BarsBox" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" VerticalAlignment="Center" ItemsSource="{Binding BarChoices, Mode=OneTime}" SelectedItem="{Binding Bars}" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Lead" />
                    <ComboBox x:Name="LeadBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" ItemsSource="{Binding LeadChoices, Mode=OneTime}" SelectedItem="{Binding Lead}" />

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Parts" />
                    <StackPanel x:Name="PartsPanel" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <CheckBox Margin="0,0,16,0" Content="Melody" IsChecked="{Binding Melody}" />
                        <CheckBox Margin="0,0,16,0" Content="Bass" IsChecked="{Binding Bass}" />
                        <CheckBox Margin="0,0,16,0" Content="Chords" IsChecked="{Binding Chords}" />
                        <CheckBox Content="Drums" IsChecked="{Binding Drums}" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Volume" />
                    <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding MusicVolume, Delay=150}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding MusicVolume, StringFormat={}{0:0.00}}" />
                </Grid>
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource Style.Text.Secondary}"
                           Text="Each mood has its own scale, chords, beat and accompaniment. The tune loops seamlessly, so it can play forever under a level."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- What it sounds like -->
        <Border Grid.Row="2"
                Margin="16,12,16,0"
                Height="96"
                Background="{DynamicResource Brush.Surface.Document}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Medium}">
            <DockPanel>
                <StackPanel Margin="10,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Button x:Name="PlayButton" Width="36" Height="36" Command="{Binding PlayCommand}" ToolTip="Play (Space)">
                        <TextBlock FontSize="16" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
                    </Button>
                    <Button x:Name="StopButton" Width="36" Height="24" Margin="0,4,0,0" Command="{Binding StopCommand}" ToolTip="Stop">
                        <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Stop}" />
                    </Button>
                </StackPanel>
                <Grid>
                    <audio:WaveformView x:Name="Waveform"
                                        Margin="4,8,12,8"
                                        Fill="{DynamicResource Brush.Accent}"
                                        Line="{DynamicResource Brush.Border.Default}"
                                        Peaks="{Binding Peaks}" />
                    <TextBlock Margin="0,4,12,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Style="{StaticResource Style.Text.Mono}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Text="{Binding Length}" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Style.Text.Secondary}"
                               Text="Writing the tune..."
                               Visibility="{Binding IsRendering, Converter={StaticResource Visible}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Save it into the project -->
        <DockPanel Grid.Row="3" Margin="16,12,16,14">
            <Button x:Name="CloseButton" Width="80" Margin="8,0,0,0" Click="OnClose" Content="Close" DockPanel.Dock="Right" />
            <Button x:Name="SaveButton" Width="96" Command="{Binding SaveCommand}" DockPanel.Dock="Right" Style="{StaticResource Style.Button.Primary}" ToolTip="Save it in the project (Ctrl+S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Save}" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Save as" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding Folder, StringFormat={}{0}/}" />
                <TextBox x:Name="NameBox" Width="180" Margin="2,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text=".wav" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Status.Error}" Text="{Binding NameError}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</controls:ChromeWindow>
