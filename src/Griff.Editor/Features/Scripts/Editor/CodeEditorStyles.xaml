<!-- Looks for the code editor's popups: the completion list. Colors match CodeTheme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit">

    <SolidColorBrush x:Key="Code.Popup.Hover" Color="#FF23262E" />
    <SolidColorBrush x:Key="Code.Popup.Selection" Color="#FF2A3F5F" />
    <SolidColorBrush x:Key="Code.Popup.Accent" Color="#FFF08C2E" />

    <Style x:Key="Style.CompletionItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="4,0,6,0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Rectangle x:Name="Bar"
                                   Width="2"
                                   Margin="0,4"
                                   HorizontalAlignment="Left"
                                   Fill="{StaticResource Code.Popup.Accent}"
                                   RadiusX="1" RadiusY="1"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Code.Popup.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Code.Popup.Selection}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.CompletionList" TargetType="cc:CompletionList">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="cc:CompletionList">
                    <cc:CompletionListBox x:Name="PART_ListBox"
                                          Padding="0,4"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FocusVisualStyle="{x:Null}"
                                          ItemContainerStyle="{StaticResource Style.CompletionItem}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Content}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </cc:CompletionListBox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
