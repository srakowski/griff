<controls:ChromeWindow x:Class="Griff.Editor.Features.Updates.UpdatesWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
                       Width="420"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       SizeToContent="Height"
                       WindowStartupLocation="CenterOwner">
    <StackPanel Background="{DynamicResource Brush.Surface.Panel}">
        <StackPanel Margin="24,20,24,0">
            <TextBlock Tag="updates:activity"
                       Text="{Binding Activity}"
                       TextWrapping="Wrap" />
            <!-- Moves while it checks or downloads: how much is downloaded once Velopack says, back and forth until then. -->
            <ProgressBar Height="6"
                         Margin="0,14,0,0"
                         IsIndeterminate="{Binding IsPercentUnknown, Mode=OneWay}"
                         Maximum="100"
                         Tag="updates:progress"
                         Value="{Binding DownloadPercent, Mode=OneWay, TargetNullValue=0}"
                         Visibility="{Binding IsBusy, Converter={x:Static converters:BoolToVisibilityConverter.Default}}" />
        </StackPanel>
        <Border Margin="0,20,0,0"
                Padding="24,12"
                Background="{DynamicResource Brush.Surface.PanelHeader}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0">
            <Button MinWidth="88"
                    HorizontalAlignment="Right"
                    Click="OnClose"
                    Content="Close"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource Style.Button.Primary}"
                    Tag="updates:close" />
        </Border>
    </StackPanel>
</controls:ChromeWindow>
