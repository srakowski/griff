---
// A screenshot from src/assets/screens/, served as it was committed: scripts/screenshots.mjs already sized and
// compressed it (lossless WebP, so pixel art and the editor's text stay sharp).
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---

<img
	src={src.src}
	width={src.width}
	height={src.height}
	alt={alt}
	loading={eager ? 'eager' : 'lazy'}
	decoding="async"
/>
