<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- No background garbage collections: one starting mid-measure counts a thread's unused allocation context as garbage (see Griff.Tests.csproj). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Griff.Editor\Griff.Editor.csproj" />
  </ItemGroup>

  <!-- Build for Web exports with the web player the editor publishes beside itself (Player\Web): the tests have it beside them too. -->
  <Target Name="CopyWebPlayer" AfterTargets="Build">
    <ItemGroup>
      <WebPlayerFile Include="..\..\src\Griff.Editor\bin\$(Configuration)\net10.0-windows\Player\Web\wwwroot\**" />
    </ItemGroup>
    <Copy SourceFiles="@(WebPlayerFile)" DestinationFiles="@(WebPlayerFile->'$(OutDir)Player\Web\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
