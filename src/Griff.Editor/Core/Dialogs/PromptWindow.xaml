<controls:ChromeWindow x:Class="Griff.Editor.Core.Dialogs.PromptWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       Width="420"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       SizeToContent="Height"
                       WindowStartupLocation="CenterOwner">
    <StackPanel Background="{DynamicResource Brush.Surface.Panel}">
        <StackPanel Margin="24,20,24,0">
            <TextBlock x:Name="LabelText" Margin="0,0,0,6" Style="{StaticResource Style.Text.Secondary}" />
            <TextBox x:Name="Input" TextChanged="OnTextChanged" />
            <DockPanel x:Name="ErrorPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Margin="0,1,8,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.Status.Error}"
                           Style="{StaticResource Style.Icon}"
                           Text="{x:Static theme:Icons.Error}" />
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Brush.Status.Error}"
                           TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
        <Border Margin="0,20,0,0"
                Padding="24,12"
                Background="{DynamicResource Brush.Surface.PanelHeader}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88" Content="Cancel" IsCancel="True" />
                <Button x:Name="OkButton"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Click="OnOk"
                        Content="OK"
                        IsDefault="True"
                        Style="{StaticResource Style.Button.Primary}" />
            </StackPanel>
        </Border>
    </StackPanel>
</controls:ChromeWindow>
