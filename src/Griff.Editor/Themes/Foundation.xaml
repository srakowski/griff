<!--
    Foundation tokens: palette, semantic brushes, typography, metrics and shared primitives.
    Every control dictionary merges this file so its StaticResource references resolve at load time.
    Use semantic Brush.* keys in UI code; Color.* palette entries exist only to define them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Palette ===== -->
    <Color x:Key="Color.Gray.950">#FF0F1013</Color>
    <Color x:Key="Color.Gray.900">#FF16171B</Color>
    <Color x:Key="Color.Gray.850">#FF1C1D22</Color>
    <Color x:Key="Color.Gray.800">#FF232429</Color>
    <Color x:Key="Color.Gray.750">#FF2A2C32</Color>
    <Color x:Key="Color.Gray.700">#FF33353D</Color>
    <Color x:Key="Color.Gray.650">#FF3C3F48</Color>
    <Color x:Key="Color.Gray.600">#FF484B55</Color>
    <Color x:Key="Color.Gray.500">#FF5E626E</Color>
    <Color x:Key="Color.Gray.400">#FF7D8290</Color>
    <Color x:Key="Color.Gray.300">#FFA1A6B2</Color>
    <Color x:Key="Color.Gray.100">#FFE2E4E9</Color>

    <Color x:Key="Color.Accent.400">#FFF5A453</Color>
    <Color x:Key="Color.Accent.500">#FFF08C2E</Color>
    <Color x:Key="Color.Accent.600">#FFD4761C</Color>

    <Color x:Key="Color.Blue.700">#FF2B4A75</Color>
    <Color x:Key="Color.Blue.400">#FF4C9AFF</Color>
    <Color x:Key="Color.Red.400">#FFE5534B</Color>
    <Color x:Key="Color.Red.600">#FFC42B1C</Color>
    <Color x:Key="Color.Yellow.400">#FFE3B341</Color>
    <Color x:Key="Color.Green.400">#FF57AB5A</Color>

    <!-- ===== Semantic brushes ===== -->

    <!-- Surfaces: chrome (title bar, toolbar, gutters, status bar) is darkest; panels sit on top of it. -->
    <SolidColorBrush x:Key="Brush.Surface.Chrome" Color="{StaticResource Color.Gray.950}" />
    <SolidColorBrush x:Key="Brush.Surface.PanelHeader" Color="{StaticResource Color.Gray.900}" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="{StaticResource Color.Gray.850}" />
    <SolidColorBrush x:Key="Brush.Surface.Document" Color="{StaticResource Color.Gray.900}" />
    <SolidColorBrush x:Key="Brush.Surface.Flyout" Color="{StaticResource Color.Gray.800}" />

    <!-- Interactive controls -->
    <SolidColorBrush x:Key="Brush.Control.Background" Color="{StaticResource Color.Gray.750}" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="{StaticResource Color.Gray.700}" />
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="{StaticResource Color.Gray.650}" />
    <SolidColorBrush x:Key="Brush.Input.Background" Color="{StaticResource Color.Gray.900}" />
    <SolidColorBrush x:Key="Brush.Item.Hover" Color="{StaticResource Color.Gray.800}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Blue.700}" />
    <SolidColorBrush x:Key="Brush.Selection.Inactive" Color="{StaticResource Color.Gray.700}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Gray.800}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Gray.600}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Gray.500}" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Accent.500}" />
    <SolidColorBrush x:Key="Brush.Border.Window" Color="{StaticResource Color.Gray.700}" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Gray.100}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Gray.300}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Gray.400}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Gray.500}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Gray.950}" />

    <!-- Accent: brand, primary actions, focus and active indicators. Not used for selection. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent.500}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.400}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.600}" />

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Red.400}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Yellow.400}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Green.400}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Blue.400}" />

    <SolidColorBrush x:Key="Brush.Caption.CloseHover" Color="{StaticResource Color.Red.600}" />

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Code">13</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">13</sys:Double>
    <sys:Double x:Key="FontSize.Title">15</sys:Double>
    <sys:Double x:Key="FontSize.Display">20</sys:Double>

    <sys:Double x:Key="IconSize.Small">10</sys:Double>
    <sys:Double x:Key="IconSize.Medium">14</sys:Double>
    <sys:Double x:Key="IconSize.Large">16</sys:Double>

    <!-- ===== Metrics ===== -->
    <CornerRadius x:Key="Radius.Small">2</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">3</CornerRadius>

    <sys:Double x:Key="Size.Control">24</sys:Double>
    <sys:Double x:Key="Size.ToolbarButton">28</sys:Double>
    <sys:Double x:Key="Size.TabHeader">28</sys:Double>
    <sys:Double x:Key="Size.TitleBar">32</sys:Double>

    <!-- Spacing scale: 2 / 4 / 8 / 12 / 16 / 24 -->
    <Thickness x:Key="Space.XXS">2</Thickness>
    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">8</Thickness>
    <Thickness x:Key="Space.M">12</Thickness>
    <Thickness x:Key="Space.L">16</Thickness>
    <Thickness x:Key="Space.XL">24</Thickness>

    <!-- ===== Shared primitives ===== -->
    <Style x:Key="Style.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1"
                               RadiusX="2" RadiusY="2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.Border.Focus}"
                               StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource IconSize.Medium}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <Style x:Key="Style.Border.Flyout" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Flyout}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <!-- Text styles -->
    <Style x:Key="Style.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Style.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Style.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>

    <!-- Uppercase section label, e.g. inspector group headings. -->
    <Style x:Key="Style.Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Style.Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Style.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Style.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>

    <Style x:Key="Style.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

</ResourceDictionary>
