<controls:ChromeWindow x:Class="Griff.Editor.Features.Projects.NewProjectWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       xmlns:projects="clr-namespace:Griff.Editor.Features.Projects"
                       mc:Ignorable="d"
                       d:DataContext="{d:DesignInstance Type=projects:NewProjectViewModel}"
                       Title="New Project"
                       Width="560"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       SizeToContent="Height"
                       WindowStartupLocation="CenterOwner">

    <StackPanel Background="{DynamicResource Brush.Surface.Panel}">
        <StackPanel Margin="24,20,24,0">
            <TextBlock Style="{StaticResource Style.Text.Title}" Text="Create a new project" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource Style.Text.Secondary}"
                       Text="A project is a folder that holds your scenes, assets and settings."
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,20,0,6" Style="{StaticResource Style.Text.Secondary}" Text="Project name" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,14,0,6" Style="{StaticResource Style.Text.Secondary}" Text="Location" />
            <DockPanel>
                <Button Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}"
                        Content="_Browse..."
                        DockPanel.Dock="Right" />
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <!-- Preview of the folder that will be created, or why it can't be. -->
            <Grid Margin="0,12,0,0" MinHeight="34">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource Style.Text.Caption}" Text="Creates the folder" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource Style.Text.Mono}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="{Binding TargetPath}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <DockPanel VerticalAlignment="Top">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock Margin="0,1,8,0"
                               VerticalAlignment="Top"
                               FontSize="{StaticResource IconSize.Medium}"
                               Foreground="{DynamicResource Brush.Status.Error}"
                               Style="{StaticResource Style.Icon}"
                               Text="{x:Static theme:Icons.Error}" />
                    <TextBlock Style="{StaticResource Style.Text.Body}"
                               Foreground="{DynamicResource Brush.Status.Error}"
                               Text="{Binding Error}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <Border Margin="0,20,0,0"
                Padding="24,12"
                Background="{DynamicResource Brush.Surface.PanelHeader}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88" Content="Cancel" IsCancel="True" />
                <Button MinWidth="88"
                        Margin="8,0,0,0"
                        Command="{Binding CreateCommand}"
                        Content="Create"
                        IsDefault="True"
                        Style="{StaticResource Style.Button.Primary}" />
            </StackPanel>
        </Border>
    </StackPanel>
</controls:ChromeWindow>
