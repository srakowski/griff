<!-- Templates for the rows editor (RowsEditor) and its cells, and the genre components' other field editors (ticks, an
     action's value, something in another scene, a stat, a fighter's moves and boxes). Each part a demo can
     click is tagged "editor:<part>" (a row's parts "editor:<part>:<row>", a cell's "editor:<column>:<row>"). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inspector="clr-namespace:Griff.Editor.Features.Inspector"
                    xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                    xmlns:theme="clr-namespace:Griff.Editor.Themes"
                    xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters">

    <converters:BoolToVisibilityConverter x:Key="Rows.Visible" />
    <converters:BoolToVisibilityConverter x:Key="Rows.Hidden" Invert="True" />
    <inspector:EditorTagConverter x:Key="Rows.Tag" />
    <inspector:TagSuffixConverter x:Key="Rows.Suffix" />

    <Style x:Key="Rows.Note" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Rows.Warning" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
    </Style>

    <Style x:Key="Rows.SmallButton" TargetType="Button" BasedOn="{StaticResource Style.Button.Toolbar}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <!-- A picker's drop-down on its own, next to a box: its list sets the box -->
    <Style x:Key="Rows.Picker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="MaxDropDownHeight" Value="260" />
    </Style>

    <!-- A tile to click (in a tile cell's tiles) -->
    <DataTemplate x:Key="Rows.Tile" DataType="inspector:TileChoice">
        <Button Width="22" Height="22" Margin="0,0,2,2" Padding="0" Command="{Binding PickCommand}" Cursor="Hand"
                Tag="{Binding Number, Converter={StaticResource Rows.Tag}, ConverterParameter=editor:tile:}" ToolTip="{Binding Tip}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{Binding Fill}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="2">
                        <Image Source="{Binding Picture}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- ===== Cells ===== -->

    <DataTemplate DataType="{x:Type inspector:TextCell}">
        <controls:CommitTextBox Margin="0,0,3,0" Tag="{Binding Tag}" Text="{Binding Value}" ToolTip="{Binding Tip}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:NumberCell}">
        <controls:NumberField Margin="0,0,3,0" IsInteger="{Binding IsInteger, Mode=OneTime}" Step="0.1" Tag="{Binding Tag}" ToolTip="{Binding Tip}" Value="{Binding Number}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:NameCell}">
        <DockPanel Margin="0,0,3,0">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Choices}" SelectedItem="{Binding Pick, Delay=1}" Style="{StaticResource Rows.Picker}"
                      Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:pick}" ToolTip="Pick one the project has" />
            <controls:CommitTextBox x:Name="Box" Tag="{Binding Tag}" Text="{Binding Value}" ToolTip="{Binding Tip}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                <Setter TargetName="Box" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                <Setter TargetName="Box" Property="ToolTip" Value="The project has none of these yet" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:ChoiceCell}">
        <ComboBox Margin="0,0,3,0" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Delay=1}" Tag="{Binding Tag}" ToolTip="{Binding Tip}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:TileCell}">
        <StackPanel Margin="0,0,3,0">
            <DockPanel>
                <Border Width="22" Height="22" Margin="0,0,3,0" Background="{Binding Fill}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="2" DockPanel.Dock="Left">
                    <Image RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Picture}" Stretch="Uniform" />
                </Border>
                <ToggleButton Width="22" Margin="2,0,0,0" DockPanel.Dock="Right" IsChecked="{Binding IsOpen}" IsEnabled="{Binding HasMap}"
                              Style="{StaticResource Style.ToggleButton.Toolbar}" Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:tiles}" ToolTip="Pick the tile off the tilemap's tilesets">
                    <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Tiles}" />
                </ToggleButton>
                <controls:CommitTextBox FontFamily="{StaticResource Font.Mono}" Tag="{Binding Tag}" Text="{Binding Value}" ToolTip="{Binding Tip}" />
            </DockPanel>
            <Popup x:Name="Tiles" AllowsTransparency="True" IsOpen="{Binding IsOpen}" Placement="Bottom" StaysOpen="False">
                <Border MaxWidth="320" MaxHeight="320" Padding="6" Background="{DynamicResource Brush.Surface.Flyout}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Focusable="False" ItemsSource="{Binding Tilesets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="inspector:TilesetChoices">
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding Name}" />
                                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource Rows.Tile}" ItemsSource="{Binding Tiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:ImageCell}">
        <DockPanel Margin="0,0,3,0">
            <Border Width="22" Height="22" Margin="0,0,3,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="2" DockPanel.Dock="Left">
                <Image RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Preview}" Stretch="Uniform" />
            </Border>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Choices}" SelectedItem="{Binding Pick, Delay=1}" Style="{StaticResource Rows.Picker}"
                      Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:pick}" ToolTip="Pick a picture from the project" />
            <controls:CommitTextBox x:Name="Box" Tag="{Binding Tag}" Text="{Binding Value}" ToolTip="{Binding Tip}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                <Setter TargetName="Box" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                <Setter TargetName="Box" Property="ToolTip" Value="There's no picture of that name in the project" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:SoundCell}">
        <DockPanel Margin="0,0,3,0">
            <Button Command="{Binding PlayCommand}" DockPanel.Dock="Right" Style="{StaticResource Rows.SmallButton}" Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:play}" ToolTip="Hear it (again to stop)">
                <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
            </Button>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Choices}" SelectedItem="{Binding Pick, Delay=1}" Style="{StaticResource Rows.Picker}"
                      Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:pick}" ToolTip="Pick a sound or music from the project" />
            <controls:CommitTextBox x:Name="Box" Tag="{Binding Tag}" Text="{Binding Value}" ToolTip="{Binding Tip}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                <Setter TargetName="Box" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                <Setter TargetName="Box" Property="ToolTip" Value="There's no sound of that name in the project" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:ColorCell}">
        <DockPanel Margin="0,0,3,0">
            <Border Width="18" Height="18" Margin="0,0,3,0" Background="{Binding Swatch}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="2" DockPanel.Dock="Left" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Palette}" SelectedItem="{Binding PickColor, Delay=1}" Style="{StaticResource Rows.Picker}"
                      Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:pick}" ToolTip="Pick a color of the palette">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="inspector:PaletteColor">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" Margin="0,0,6,0" Background="{Binding Brush}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" />
                            <TextBlock FontFamily="{StaticResource Font.Mono}" Text="{Binding Hex}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:CommitTextBox FontFamily="{StaticResource Font.Mono}" Tag="{Binding Tag}" Text="{Binding Value}" ToolTip="{Binding Tip}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:AmountsCell}">
        <WrapPanel Margin="0,0,3,0">
            <ItemsControl Focusable="False" ItemsSource="{Binding Parts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspector:AmountPart">
                        <Border Margin="0,0,4,3" Padding="4,1,1,1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="3">
                            <StackPanel Orientation="Horizontal">
                                <controls:CommitTextBox x:Name="Name" MinWidth="60" Tag="{Binding Tag}" Text="{Binding Name}" ToolTip="What it is" />
                                <controls:NumberField Width="48" Margin="3,0,0,0" IsInteger="True" Label="×" Step="0.1" Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:count}" ToolTip="How many" Value="{Binding Count}" />
                                <Button Command="{Binding RemoveCommand}" Style="{StaticResource Rows.SmallButton}" Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:remove}" ToolTip="Take it out">
                                    <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                                <Setter TargetName="Name" Property="ToolTip" Value="The project has none of these yet" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox MinWidth="80" Margin="0,0,0,3" ItemsSource="{Binding Choices}" SelectedItem="{Binding AddPick, Delay=1}" Tag="{Binding Tag, Converter={StaticResource Rows.Suffix}, ConverterParameter=:add}" ToolTip="Add one the project has" />
        </WrapPanel>
    </DataTemplate>

    <!-- ===== Rows ===== -->

    <DataTemplate DataType="{x:Type inspector:RowsEditor}">
        <StackPanel>
            <ItemsControl Margin="22,0,48,1" Focusable="False" ItemsSource="{Binding Headers}" Visibility="{Binding ShowsHeaders, Converter={StaticResource Rows.Visible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid inspector:GridColumns.Widths="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Column" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.AlternationCount>16</ItemsControl.AlternationCount>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspector:RowsRow">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Width="18" Margin="0,4,0,0" VerticalAlignment="Top" DockPanel.Dock="Left" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Number}"
                                       Visibility="{Binding IsListed, Converter={StaticResource Rows.Visible}}" />
                            <Button VerticalAlignment="Top" Command="{Binding RemoveCommand}" DockPanel.Dock="Right" Style="{StaticResource Rows.SmallButton}"
                                    Tag="{Binding Number, Converter={StaticResource Rows.Tag}, ConverterParameter=editor:remove:}" ToolTip="Take this row out"
                                    Visibility="{Binding IsListed, Converter={StaticResource Rows.Visible}}">
                                <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                            </Button>
                            <Button VerticalAlignment="Top" Command="{Binding MoveUpCommand}" DockPanel.Dock="Right" IsEnabled="{Binding CanMoveUp}" Style="{StaticResource Rows.SmallButton}"
                                    Tag="{Binding Number, Converter={StaticResource Rows.Tag}, ConverterParameter=editor:up:}" ToolTip="Move it up the list"
                                    Visibility="{Binding IsListed, Converter={StaticResource Rows.Visible}}">
                                <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.MoveUp}" />
                            </Button>
                            <StackPanel>
                                <StackPanel Visibility="{Binding Reads, Converter={StaticResource Rows.Visible}}">
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Narrow}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid inspector:GridColumns.Widths="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Grid.Column" Value="{Binding Slot}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Wide}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="inspector:RowCell">
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock Width="48" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    <ContentControl HorizontalContentAlignment="Stretch" Content="{Binding}" Focusable="False" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Margin="0,2,0,0" Focusable="False" ItemsSource="{Binding Under}" Visibility="{Binding HasUnder, Converter={StaticResource Rows.Visible}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid inspector:GridColumns.Widths="{Binding DataContext.UnderLayout, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Grid.Column" Value="{Binding Slot}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="inspector:RowCell">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    <ContentControl HorizontalContentAlignment="Stretch" Content="{Binding}" Focusable="False" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Rows.Note}" Tag="{Binding Number, Converter={StaticResource Rows.Tag}, ConverterParameter=editor:note:}" Text="{Binding Note}"
                                               Visibility="{Binding HasNote, Converter={StaticResource Rows.Visible}}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding Reads, Converter={StaticResource Rows.Hidden}}">
                                    <controls:CommitTextBox FontFamily="{StaticResource Font.Mono}" Tag="{Binding Number, Converter={StaticResource Rows.Tag}, ConverterParameter=editor:row:}" Text="{Binding Text}" />
                                    <TextBlock Style="{StaticResource Rows.Warning}" Text="{Binding Problem}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left" Margin="0,1,0,0" Padding="8,2" Command="{Binding AddCommand}" Tag="editor:add" ToolTip="Put a new row on the end"
                    Visibility="{Binding IsList, Converter={StaticResource Rows.Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding AddText}" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Rows.Warning}" Tag="editor:problem" Text="{Binding Field.ValueProblem}" Visibility="{Binding Field.HasValueProblem, Converter={StaticResource Rows.Visible}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===== Other editors ===== -->

    <!-- Several names ticked from what the component lists -->
    <DataTemplate DataType="{x:Type inspector:ChoicesEditor}">
        <StackPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Ticks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspector:ChoiceTick">
                        <CheckBox x:Name="Tick" Margin="0,0,10,3" Content="{Binding Name}" IsChecked="{Binding IsTicked}" Tag="{Binding Tag}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                                <Setter TargetName="Tick" Property="ToolTip" Value="There's none of these to pick: untick it to take it out" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Rows.Note}" Text="{Binding Summary}" />
            <TextBlock Style="{StaticResource Rows.Note}" Text="Nothing to pick yet." Visibility="{Binding IsEmpty, Converter={StaticResource Rows.Visible}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Something in another scene, picked from that scene's -->
    <DataTemplate DataType="{x:Type inspector:InSceneEditor}">
        <StackPanel>
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Delay=1}" Tag="editor:choice" ToolTip="A hotspot or anything else in that scene" />
            <TextBlock Style="{StaticResource Rows.Warning}" Tag="editor:problem" Text="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource Rows.Visible}}" />
        </StackPanel>
    </DataTemplate>

    <!-- A number of a target's components -->
    <DataTemplate DataType="{x:Type inspector:StatEditor}">
        <DockPanel>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Choices}" SelectedItem="{Binding Pick, Delay=1}" Style="{StaticResource Rows.Picker}" Tag="editor:pick" ToolTip="Pick a number of the scene's cards and what has health" />
            <controls:CommitTextBox Tag="editor:value" Text="{Binding Value}" />
        </DockPanel>
    </DataTemplate>

    <!-- A fighter's moves: each with its input as arrows, and the Move List a click away -->
    <DataTemplate DataType="{x:Type inspector:MovesEditor}">
        <StackPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Moves}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspector:MoveLine">
                        <StackPanel Margin="0,0,0,2">
                            <DockPanel>
                                <TextBlock Margin="6,0,0,0" DockPanel.Dock="Right" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Frames}" ToolTip="Startup / active / recovery, in frames" />
                                <TextBlock Margin="6,0,0,0" DockPanel.Dock="Right" Text="{Binding Input}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Rows.Warning}" Text="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource Rows.Visible}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,2,0,0">
                <Button Padding="8,2" Command="{Binding OpenCommand}" DockPanel.Dock="Left" Tag="editor:movelist" ToolTip="Edit the moves: their inputs, frames and what they cancel into (Entity > Edit Moves)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Rename}" />
                        <TextBlock Margin="6,0,0,0" Text="Move List" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Summary}" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A fighter's boxes: how many on each clip, and the Clip Editor a click away -->
    <DataTemplate DataType="{x:Type inspector:FrameBoxesEditor}">
        <StackPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Clips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,1" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,2,0,0">
                <Button Padding="8,2" Command="{Binding OpenCommand}" DockPanel.Dock="Left" Tag="editor:clipeditor" ToolTip="Draw the boxes over the frames (Art > Animation Clips)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
                        <TextBlock Margin="6,0,0,0" Text="Clip Editor" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Summary}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Style="{StaticResource Rows.Warning}" Tag="editor:problem" Text="{Binding Field.ValueProblem}" Visibility="{Binding Field.HasValueProblem, Converter={StaticResource Rows.Visible}}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
