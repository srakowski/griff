<controls:ChromeWindow x:Class="Griff.Editor.Features.DesignSystem.DesignSystemWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       Title="Design System Gallery"
                       Width="1100" Height="820"
                       WindowStartupLocation="CenterOwner">

    <controls:ChromeWindow.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Title}">
            <Setter Property="Margin" Value="0,28,0,12" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
            <Setter Property="Padding" Value="{StaticResource Space.L}" />
        </Style>

        <DataTemplate x:Key="SwatchTemplate">
            <StackPanel Width="230" Margin="0,0,8,10" Orientation="Horizontal">
                <Border Width="32" Height="32"
                        Background="{Binding Brush}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Style.Text.Body}" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource Style.Text.Caption}" FontFamily="{StaticResource Font.Mono}" Text="{Binding Hex}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </controls:ChromeWindow.Resources>

    <ScrollViewer Background="{DynamicResource Brush.Surface.Document}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,8,32,40">

            <TextBlock Margin="0,16,0,4" Style="{StaticResource Style.Text.Display}" Text="Griff Design System" />
            <TextBlock Style="{StaticResource Style.Text.Secondary}"
                       Text="Every token and control style in Themes/. This page reads resources live, so it is always current." />

            <!-- Semantic brushes -->
            <TextBlock Style="{StaticResource Section}" Text="Semantic brushes" />
            <TextBlock Margin="0,-6,0,12" Style="{StaticResource Style.Text.Caption}" Text="Use these in UI code. Brush.Surface → Brush.Control → Brush.Border → Brush.Text, plus Accent and Status." />
            <ItemsControl x:Name="BrushList" ItemTemplate="{StaticResource SwatchTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />

            <!-- Palette -->
            <TextBlock Style="{StaticResource Section}" Text="Palette" />
            <TextBlock Margin="0,-6,0,12" Style="{StaticResource Style.Text.Caption}" Text="Raw colors. Only Foundation.xaml should reference these." />
            <ItemsControl x:Name="ColorList" ItemTemplate="{StaticResource SwatchTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />

            <!-- Typography -->
            <TextBlock Style="{StaticResource Section}" Text="Typography" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Style.Text.Display}" Text="Display — Segoe UI Light 20" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Title}" Text="Title — SemiBold 15" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Subtitle}" Text="Subtitle — SemiBold 13" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Body}" Text="Body — Regular 12. The default for all UI text." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Secondary}" Text="Secondary — labels and supporting text" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Caption}" Text="Caption — 11, status bar and metadata" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Overline}" Text="Overline — section labels" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Style.Text.Mono}" Text="Mono — Cascadia Mono: transform.position = Vector3.zero;" />
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <TextBlock Style="{StaticResource Section}" Text="Buttons" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Default" />
                        <Button Margin="8,0,0,0" Content="Primary" Style="{StaticResource Style.Button.Primary}" />
                        <Button Margin="8,0,0,0" Content="Disabled" IsEnabled="False" />
                        <ToggleButton Margin="8,0,0,0" Content="Toggle" />
                        <ToggleButton Margin="8,0,0,0" Content="Toggle (on)" IsChecked="True" />
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource Style.Button.Toolbar}" ToolTip="Play">
                            <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
                        </Button>
                        <Button Style="{StaticResource Style.Button.Toolbar}" ToolTip="Pause">
                            <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Pause}" />
                        </Button>
                        <Button Style="{StaticResource Style.Button.Toolbar}" ToolTip="Stop">
                            <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Stop}" />
                        </Button>
                        <Separator Style="{StaticResource Style.Separator.Vertical}" />
                        <ToggleButton IsChecked="True" Style="{StaticResource Style.ToggleButton.Toolbar}" ToolTip="Toolbar toggle (on)">
                            <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Search}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource Style.ToggleButton.Toolbar}" ToolTip="Toolbar toggle (off)">
                            <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Settings}" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Inputs -->
            <TextBlock Style="{StaticResource Section}" Text="Inputs" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Name" />
                    <TextBox Grid.Column="1" Text="PlayerController" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Read only" />
                    <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="Assets/Scripts/Player.cs" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Disabled" />
                    <TextBox Grid.Row="4" Grid.Column="1" IsEnabled="False" Text="Unavailable" />

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Layer" />
                    <ComboBox Grid.Column="4" SelectedIndex="0">
                        <ComboBoxItem Content="Default" />
                        <ComboBoxItem Content="UI" />
                        <ComboBoxItem Content="Water" />
                        <ComboBoxItem Content="Ignore Raycast" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Flags" />
                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                        <CheckBox Content="Static" IsChecked="True" />
                        <CheckBox Margin="16,0,0,0" Content="Mixed" IsChecked="{x:Null}" IsThreeState="True" />
                        <CheckBox Margin="16,0,0,0" Content="Off" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Disabled" />
                    <CheckBox Grid.Row="4" Grid.Column="4" Content="Unavailable" IsChecked="True" IsEnabled="False" />
                </Grid>
            </Border>

            <!-- Lists and trees -->
            <TextBlock Style="{StaticResource Section}" Text="Lists and trees" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="200" Padding="0,4" Style="{StaticResource Card}">
                    <TreeView>
                        <TreeViewItem Header="Main Camera" />
                        <TreeViewItem Header="Directional Light" />
                        <TreeViewItem Header="Player" IsExpanded="True">
                            <TreeViewItem Header="Model" IsSelected="True" />
                            <TreeViewItem Header="Weapon Socket">
                                <TreeViewItem Header="Sword" />
                            </TreeViewItem>
                            <TreeViewItem Header="Camera Rig" />
                        </TreeViewItem>
                        <TreeViewItem Header="Environment" />
                    </TreeView>
                </Border>
                <Border Grid.Column="2" Height="200" Padding="0,4" Style="{StaticResource Card}">
                    <ListBox SelectedIndex="1">
                        <ListBoxItem Content="Materials" />
                        <ListBoxItem Content="Meshes" />
                        <ListBoxItem Content="Prefabs" />
                        <ListBoxItem Content="Scenes" />
                        <ListBoxItem Content="Scripts" />
                        <ListBoxItem Content="Textures" />
                    </ListBox>
                </Border>
            </Grid>

            <!-- Tabs -->
            <TextBlock Style="{StaticResource Section}" Text="Tabs" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TabControl Height="120">
                    <TabItem Header="Hierarchy">
                        <TextBlock Margin="12" Style="{StaticResource Style.Text.Secondary}" Text="Tool panel tabs. The accent line appears on the focused group." />
                    </TabItem>
                    <TabItem Header="Project" />
                    <TabItem Header="Inspector" />
                </TabControl>
                <TabControl Grid.Column="2" Height="120" Style="{StaticResource Style.TabControl.Document}">
                    <TabItem Header="Level01.scene">
                        <TextBlock Margin="12" Style="{StaticResource Style.Text.Secondary}" Text="Document tabs for the central editing area." />
                    </TabItem>
                    <TabItem Header="Player.cs*" />
                </TabControl>
            </Grid>

            <!-- Icons -->
            <TextBlock Style="{StaticResource Section}" Text="Icons" />
            <TextBlock Margin="0,-6,0,12" Style="{StaticResource Style.Text.Caption}" Text="Themes/Icons.cs — Segoe Fluent Icons with MDL2 fallback." />
            <ItemsControl x:Name="IconList" ItemsPanel="{StaticResource WrapPanelTemplate}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="96" Margin="0,0,8,16">
                            <TextBlock FontSize="{StaticResource IconSize.Large}" Style="{StaticResource Style.Icon}" Text="{Binding Glyph}" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Style.Text.Caption}" Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</controls:ChromeWindow>
