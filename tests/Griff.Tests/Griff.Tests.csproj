<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      No background garbage collections while the tests run. One that starts while a thread is between allocations counts
      what was left of that thread's allocation context (up to a few KB) as allocated by it, so a test that checks code
      makes no garbage would see some whenever another test running alongside set one off. Blocking collections don't.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The web player's own logic (its keys, controllers and save keys): Griff.Web targets the browser, so a test can't reference it. -->
  <ItemGroup>
    <Compile Include="..\..\src\Griff.Web\WebKeys.cs" Link="Web\WebKeys.cs" />
    <Compile Include="..\..\src\Griff.Web\WebGamepad.cs" Link="Web\WebGamepad.cs" />
    <Compile Include="..\..\src\Griff.Web\WebSaves.cs" Link="Web\WebSaves.cs" />
  </ItemGroup>

  <!-- Griff's free fonts, where FreeFonts looks for them (beside the editor, here beside the tests). -->
  <ItemGroup>
    <None Include="..\..\src\Griff.Fonts\Free\*.ttf;..\..\src\Griff.Fonts\Free\*.txt" Link="FreeFonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Griff\Griff.csproj" />
    <ProjectReference Include="..\..\src\Griff.Fonts\Griff.Fonts.csproj" />
    <ProjectReference Include="..\..\src\Griff.Graphics\Griff.Graphics.csproj" />
    <ProjectReference Include="..\..\src\Griff.Scripting\Griff.Scripting.csproj" />
  </ItemGroup>

</Project>