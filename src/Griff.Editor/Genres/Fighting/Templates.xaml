<!-- The Fighting genre's templates: a fighter's moves and boxes in the Inspector, and the hitboxes and hurtboxes the Clip
     Editor shows for the frame (HitboxOverlay: its panel beside the preview, and HitboxCanvas over the frame). Found with
     every genre's Templates.xaml (GenreTemplates), so neither the Inspector nor the Clip Editor names them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fighting="clr-namespace:Griff.Editor.Genres.Fighting"
                    xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                    xmlns:theme="clr-namespace:Griff.Editor.Themes"
                    xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters">

    <converters:BoolToVisibilityConverter x:Key="Fighting.Visible" />

    <Style x:Key="Fighting.Warning" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
    </Style>

    <Style x:Key="Fighting.Heading" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Overline}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Fighting.Tool" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="Fighting.Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- A fighter's moves: each with its input as arrows, and the Move List a click away -->
    <DataTemplate DataType="{x:Type fighting:MovesEditor}">
        <StackPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Moves}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="fighting:MoveLine">
                        <StackPanel Margin="0,0,0,2">
                            <DockPanel>
                                <TextBlock Margin="6,0,0,0" DockPanel.Dock="Right" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Frames}" ToolTip="Startup / active / recovery, in frames" />
                                <TextBlock Margin="6,0,0,0" DockPanel.Dock="Right" Text="{Binding Input}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Fighting.Warning}" Text="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource Fighting.Visible}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,2,0,0">
                <Button Padding="8,2" Command="{Binding OpenCommand}" DockPanel.Dock="Left" Tag="editor:movelist" ToolTip="Edit the moves: their inputs, frames and what they cancel into (Entity > Edit Moves)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Rename}" />
                        <TextBlock Margin="6,0,0,0" Text="Move List" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Summary}" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A fighter's boxes: how many on each clip, and the Clip Editor a click away -->
    <DataTemplate DataType="{x:Type fighting:FrameBoxesEditor}">
        <StackPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Clips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,1" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,2,0,0">
                <Button Padding="8,2" Command="{Binding OpenCommand}" DockPanel.Dock="Left" Tag="editor:clipeditor" ToolTip="Draw the boxes over the frames (Art > Animation Clips)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
                        <TextBlock Margin="6,0,0,0" Text="Clip Editor" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Summary}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Style="{StaticResource Fighting.Warning}" Tag="editor:problem" Text="{Binding Field.ValueProblem}" Visibility="{Binding Field.HasValueProblem, Converter={StaticResource Fighting.Visible}}" />
        </StackPanel>
    </DataTemplate>

    <!-- The Clip Editor's frame's hitboxes and hurtboxes, beside the preview -->
    <DataTemplate DataType="{x:Type fighting:HitboxOverlay}">
                <DockPanel x:Name="BoxesPanel" Width="220" Margin="16,0,0,0" IsEnabled="{Binding CanEditBoxes}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Fighting.Heading}" Text="Boxes" />
                    <UniformGrid x:Name="BoxTools" Columns="3" DockPanel.Dock="Top">
                        <RadioButton x:Name="SelectTool" Content="Select" GroupName="BoxTool" IsChecked="{Binding IsSelectTool}" Style="{StaticResource Fighting.Tool}" ToolTip="Pick a box to move it, or drag its corners (S)" />
                        <RadioButton x:Name="HitboxTool" Content="Hitbox" GroupName="BoxTool" IsChecked="{Binding IsHitboxTool}" Style="{StaticResource Fighting.Tool}" ToolTip="Drag over the picture to draw a hitbox: where it hits (H)" />
                        <RadioButton x:Name="HurtboxTool" Content="Hurtbox" GroupName="BoxTool" IsChecked="{Binding IsHurtboxTool}" Style="{StaticResource Fighting.Tool}" ToolTip="Drag over the picture to draw a hurtbox: where it can be hit (U)" />
                    </UniformGrid>
                    <CheckBox x:Name="CirclesBox" Margin="0,6,0,0" Content="Draw circles" DockPanel.Dock="Top" IsChecked="{Binding DrawCircles}" ToolTip="Draw circles instead of boxes (C)" />
                    <Button x:Name="CopyPreviousButton"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CopyPreviousFrameCommand}"
                            Content="Copy From Previous Frame"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Fighting.Small}"
                            ToolTip="Give this frame the boxes of the frame before it (Ctrl+D)" />
                    <TextBlock x:Name="BoxesSummary" Margin="0,4,0,6" DockPanel.Dock="Top" Style="{StaticResource Style.Text.Secondary}" Text="{Binding BoxesSummary}" TextWrapping="Wrap" />

                    <!-- The box picked -->
                    <StackPanel x:Name="BoxSettings" Margin="0,8,0,0" DockPanel.Dock="Bottom" Visibility="{Binding HasSelectedBox, Converter={StaticResource Fighting.Visible}}">
                        <TextBlock x:Name="BoxLabel" Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding SelectedBox.Label}" TextWrapping="Wrap" />
                        <StackPanel x:Name="HitSettings" Visibility="{Binding IsHitboxSelected, Converter={StaticResource Fighting.Visible}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Width="80" VerticalAlignment="Center" Text="Damage" />
                                <controls:CommitTextBox x:Name="DamageBox" Text="{Binding BoxDamage, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Hit points it takes, before the hurtbox multiplies it" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Width="80" VerticalAlignment="Center" Text="Knockback" />
                                <controls:CommitTextBox x:Name="KnockbackYBox" Width="56" DockPanel.Dock="Right" Text="{Binding BoxKnockbackY, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Up, in units a second" />
                                <controls:CommitTextBox x:Name="KnockbackXBox" Margin="0,0,4,0" Text="{Binding BoxKnockbackX, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Away, in units a second" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Width="80" VerticalAlignment="Center" Text="Stun" />
                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Style.Text.Secondary}" Text="frames" />
                                <controls:CommitTextBox x:Name="StunBox" Text="{Binding BoxStun, UpdateSourceTrigger=LostFocus}" ToolTip="Steps of hitstun (frames, at 60 a second)" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Width="80" VerticalAlignment="Center" Text="Group" />
                                <controls:CommitTextBox x:Name="GroupBox" Text="{Binding BoxGroup, UpdateSourceTrigger=LostFocus}" ToolTip="A swing hits each thing once per group" />
                            </DockPanel>
                        </StackPanel>
                        <DockPanel x:Name="HurtSettings" Margin="0,0,0,4" Visibility="{Binding IsHurtboxSelected, Converter={StaticResource Fighting.Visible}}">
                            <TextBlock Width="80" VerticalAlignment="Center" Text="Multiplier" />
                            <controls:CommitTextBox x:Name="MultiplierBox" Text="{Binding BoxMultiplier, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Hits here deal this many times their damage: 1.5 for a head" />
                        </DockPanel>
                        <Button x:Name="RemoveBoxButton" Margin="0,4,0,0" HorizontalAlignment="Left" Command="{Binding RemoveBoxCommand}" Style="{StaticResource Fighting.Small}" ToolTip="Remove this box (Delete)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                                <TextBlock Text="Remove Box" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox x:Name="BoxList" ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="fighting:FrameBoxRow">
                                <DockPanel Margin="2,3">
                                    <Border x:Name="Swatch" Width="10" Height="10" Margin="0,3,6,0" VerticalAlignment="Top" Background="#4DA3FF" CornerRadius="2" DockPanel.Dock="Left" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding Place}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                        <Setter TargetName="Swatch" Property="Background" Value="#FF4D54" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
    </DataTemplate>

    <!-- ...and over the frame, to draw, pick, move and resize with the mouse -->
    <DataTemplate DataType="{x:Type fighting:HitboxDrawing}">
        <fighting:HitboxCanvas x:Name="BoxCanvas" Background="Transparent" ClipToBounds="True" />
    </DataTemplate>

</ResourceDictionary>
