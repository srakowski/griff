<UserControl x:Class="Griff.Editor.Features.Assets.AssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:assets="clr-namespace:Griff.Editor.Features.Assets"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=assets:AssetsPanel}">
    <Grid>
        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Roots}"
                  MouseDoubleClick="OnDoubleClick"
                  PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                  PreviewMouseMove="OnPreviewMouseMove"
                  PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
                  AllowDrop="True"
                  DragOver="OnDragOver"
                  Drop="OnDrop"
                  Visibility="{Binding HasProject, Converter={x:Static converters:BoolToVisibilityConverter.Default}}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="assets:AssetNode" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Glyph"
                                   Margin="0,0,6,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Style="{StaticResource Style.Icon}"
                                   Text="{Binding Icon}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        <TextBlock x:Name="StartBadge"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Text="start scene"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsStartScene}" Value="True">
                            <Setter TargetName="StartBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static assets:AssetKind.Folder}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static assets:AssetKind.Script}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Status.Info}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static assets:AssetKind.Scene}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static assets:AssetKind.Prefab}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource Style.Text.Caption}"
                   Text="No project open"
                   Visibility="{Binding HasProject, Converter={x:Static converters:BoolToVisibilityConverter.Inverted}}" />
    </Grid>
</UserControl>
