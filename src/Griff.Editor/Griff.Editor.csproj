<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Griff\Griff.csproj" />
    <ProjectReference Include="..\Griff.Platform.Windows\Griff.Platform.Windows.csproj" />
    <ProjectReference Include="..\Griff.Scripting\Griff.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The player is self-contained; the editor isn't. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- Ship the game player next to the editor so Build Game can export it. -->
  <ItemGroup>
    <ProjectReference Include="..\Griff.Player\Griff.Player.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyPlayer" AfterTargets="Build">
    <ItemGroup>
      <PlayerFiles Include="..\Griff.Player\bin\$(Configuration)\$(TargetFramework)\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerFiles)" DestinationFiles="@(PlayerFiles->'$(OutDir)Player\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
