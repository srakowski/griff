<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The web player's own logic, its keys and frames: Griff.Web targets the browser, so a test can't reference it. -->
  <ItemGroup>
    <Compile Include="..\..\src\Griff.Web\WebKeys.cs" Link="Web\WebKeys.cs" />
    <Compile Include="..\..\src\Griff.Web\WebFrame.cs" Link="Web\WebFrame.cs" />
  </ItemGroup>

  <!-- Griff's free fonts, where FreeFonts looks for them (beside the editor, here beside the tests). -->
  <ItemGroup>
    <None Include="..\..\src\Griff.Fonts\Free\*.ttf;..\..\src\Griff.Fonts\Free\*.txt" Link="FreeFonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Griff\Griff.csproj" />
    <ProjectReference Include="..\..\src\Griff.Fonts\Griff.Fonts.csproj" />
    <ProjectReference Include="..\..\src\Griff.Scripting\Griff.Scripting.csproj" />
  </ItemGroup>

</Project>