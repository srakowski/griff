<UserControl x:Class="Griff.Editor.Features.Hierarchy.HierarchyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hierarchy="clr-namespace:Griff.Editor.Features.Hierarchy"
             xmlns:theme="clr-namespace:Griff.Editor.Themes"
             xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=hierarchy:HierarchyPanel}"
             d:DesignHeight="400" d:DesignWidth="280">
    <Grid>
        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasScene}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Scene name + create button -->
            <Border DockPanel.Dock="Top"
                    Padding="10,2,4,2"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button x:Name="AddButton"
                            Click="OnAddClicked"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Style.Button.Toolbar}"
                            ToolTip="Create">
                        <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Overline}" Text="{Binding SceneName}" />
                </DockPanel>
            </Border>

            <TreeView x:Name="Tree"
                      AllowDrop="True"
                      ItemsSource="{Binding Roots}"
                      DragLeave="OnDragLeave"
                      DragOver="OnDragOver"
                      Drop="OnDrop"
                      KeyDown="OnKeyDown"
                      PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                      PreviewMouseMove="OnPreviewMouseMove"
                      PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <!-- The tree's own selection is the primary entity; every selected row is highlighted. -->
                        <Setter Property="IsSelected" Value="{Binding IsPrimary, Mode=TwoWay}" />
                        <Setter Property="controls:TreeSelection.IsSelected" Value="{Binding IsSelected}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="hierarchy:EntityNode" ItemsSource="{Binding Children}">
                        <Grid x:Name="Row" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Drop indicators -->
                            <Border x:Name="DropInto"
                                    Grid.ColumnSpan="4"
                                    Margin="-4,-2"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Visibility="Collapsed" />
                            <Rectangle x:Name="DropBefore" Grid.ColumnSpan="4" Height="2" Margin="-4,-4,0,0" VerticalAlignment="Top" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                            <Rectangle x:Name="DropAfter" Grid.ColumnSpan="4" Height="2" Margin="-4,0,0,-4" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />

                            <!-- A placed copy of a prefab: saving the prefab updates it. -->
                            <TextBlock x:Name="PrefabMark"
                                       Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource IconSize.Small}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       Style="{StaticResource Style.Icon}"
                                       Text="{x:Static theme:Icons.Package}"
                                       ToolTip="{Binding PrefabTip}"
                                       Visibility="Collapsed" />

                            <!-- Lock: shown on locked rows (faint when a parent's lock covers it), and on hover to lock one. -->
                            <ToggleButton x:Name="LockToggle"
                                          Grid.Column="2"
                                          Margin="6,0,0,0"
                                          Cursor="Hand"
                                          Focusable="False"
                                          IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                          Opacity="0"
                                          ToolTip="Lock in the Scene view: clicks pass through it">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Width="18" Height="18" Background="Transparent">
                                            <TextBlock FontSize="{StaticResource IconSize.Small}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Style="{StaticResource Style.Icon}"
                                                       Text="{x:Static theme:Icons.Lock}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Eye: shut on hidden rows (faint when a parent's hiding covers it), and open on hover to hide one. -->
                            <ToggleButton x:Name="HideToggle"
                                          Grid.Column="3"
                                          Margin="2,0,0,0"
                                          Cursor="Hand"
                                          Focusable="False"
                                          IsChecked="{Binding IsHidden, Mode=TwoWay}"
                                          Opacity="0"
                                          Tag="{x:Static theme:Icons.Show}"
                                          ToolTip="Hide in the Scene view (the game still shows it)">
                                <!-- Its Tag is the glyph: an open eye, shut on hidden rows and those a parent hides. -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Width="18" Height="18" Background="Transparent">
                                            <TextBlock FontSize="{StaticResource IconSize.Small}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Style="{StaticResource Style.Icon}"
                                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <TextBlock x:Name="Label" VerticalAlignment="Center" Text="{Binding Name}" />
                            <TextBox x:Name="Editor"
                                     MinHeight="20"
                                     Padding="2,0"
                                     IsUndoEnabled="False"
                                     IsVisibleChanged="OnRenameVisibleChanged"
                                     KeyDown="OnRenameKeyDown"
                                     LostKeyboardFocus="OnRenameLostFocus"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPrefabCopy}" Value="True">
                                <Setter TargetName="PrefabMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="LockToggle" Property="Opacity" Value="0.6" />
                                <Setter TargetName="HideToggle" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLockedByParent}" Value="True">
                                <Setter TargetName="LockToggle" Property="Opacity" Value="0.4" />
                                <Setter TargetName="LockToggle" Property="ToolTip" Value="Locked with its parent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter TargetName="LockToggle" Property="Opacity" Value="1" />
                                <Setter TargetName="LockToggle" Property="ToolTip" Value="Locked in the Scene view: click to unlock" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHiddenByParent}" Value="True">
                                <Setter TargetName="HideToggle" Property="Opacity" Value="0.4" />
                                <Setter TargetName="HideToggle" Property="ToolTip" Value="Hidden with its parent" />
                                <Setter TargetName="HideToggle" Property="Tag" Value="{x:Static theme:Icons.Hide}" />
                                <Setter TargetName="Label" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="HideToggle" Property="Opacity" Value="1" />
                                <Setter TargetName="HideToggle" Property="ToolTip" Value="Hidden in the Scene view: click to show" />
                                <Setter TargetName="HideToggle" Property="Tag" Value="{x:Static theme:Icons.Hide}" />
                                <Setter TargetName="Label" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropHint}" Value="{x:Static hierarchy:DropPosition.Into}">
                                <Setter TargetName="DropInto" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropHint}" Value="{x:Static hierarchy:DropPosition.Before}">
                                <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropHint}" Value="{x:Static hierarchy:DropPosition.After}">
                                <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource Style.Text.Caption}"
                   Text="No scene open">
            <TextBlock.Visibility>
                <Binding Path="HasScene">
                    <Binding.Converter>
                        <converters:BoolToVisibilityConverter Invert="True" />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Visibility>
        </TextBlock>
    </Grid>
</UserControl>
