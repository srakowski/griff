<UserControl x:Class="Griff.Editor.Features.Inspector.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:Griff.Editor.Features.Inspector"
             xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             xmlns:theme="clr-namespace:Griff.Editor.Themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:InspectorPanel}"
             d:DesignHeight="600" d:DesignWidth="320"
             AllowDrop="True"
             PreviewDragOver="OnPreviewDragOver"
             PreviewDrop="OnPreviewDrop"
             controls:NumberField.EditCompleted="OnEditCompleted">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FieldTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="Visible" />
            <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasEntity, Converter={StaticResource Visible}}">
            <StackPanel Margin="0,0,0,16">

                <!-- Entity header: the name, or with several selected, how many (their names in the tooltip) -->
                <DockPanel Margin="10,10,10,8" DataContext="{Binding Header}">
                    <CheckBox Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}"
                              ToolTip="Enabled" />
                    <Grid>
                        <controls:CommitTextBox FontSize="{StaticResource FontSize.Subtitle}"
                                                Text="{Binding Name}"
                                                Visibility="{Binding IsSeveral, Converter={StaticResource Hidden}}" />
                        <TextBlock x:Name="SeveralName"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSize.Subtitle}"
                                   Text="{Binding Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Names}"
                                   Visibility="{Binding IsSeveral, Converter={StaticResource Visible}}" />
                    </Grid>
                </DockPanel>

                <!-- A placed copy of a prefab: which one -->
                <DockPanel x:Name="PrefabNote"
                           Margin="10,0,10,8"
                           DataContext="{Binding Header}"
                           ToolTip="Saving the prefab (Entity, Save as Prefab) updates every copy of it, in every scene, keeping what each copy changed (the marked fields). Entity, Revert to Prefab undoes those changes."
                           Visibility="{Binding HasPrefabNote, Converter={StaticResource Visible}}">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource IconSize.Small}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Style="{StaticResource Style.Icon}"
                               Text="{x:Static theme:Icons.Package}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Style.Text.Caption}"
                               Text="{Binding PrefabNote}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Margin="10,0,10,8"
                           Style="{StaticResource Style.Text.Caption}"
                           Text="{Binding HiddenNote}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasHiddenNote, Converter={StaticResource Visible}}" />

                <!-- Filter: only fields whose names have what's typed (Escape empties it) -->
                <controls:FilterBox x:Name="FieldFilter"
                                    Margin="10,0,10,8"
                                    Placeholder="Filter fields"
                                    Tag="filter:fields"
                                    Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Show only the fields whose names have this in them" />
                <TextBlock Margin="10,0,10,8"
                           Style="{StaticResource Style.Text.Caption}"
                           Text="{Binding FilterNote}"
                           Visibility="{Binding HasFilterNote, Converter={StaticResource Visible}}" />

                <!-- Components -->
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="inspector:ComponentSection">
                            <StackPanel x:Name="SectionRoot">
                                <!-- Section header: right-click for Reset, Copy and Paste Values, Move Up and Down -->
                                <Border x:Name="SectionHeader"
                                        Padding="4,0,4,0"
                                        Background="{DynamicResource Brush.Surface.PanelHeader}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="0,1"
                                        Tag="header">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding HeaderMenuCommand}"
                                                      CommandParameter="{Binding ElementName=SectionHeader}"
                                                      Gesture="RightClick" />
                                    </Border.InputBindings>
                                    <DockPanel Height="28">
                                        <Button x:Name="RemoveButton"
                                                Command="{Binding RemoveCommand}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Style.Button.Toolbar}"
                                                Tag="remove"
                                                ToolTip="{Binding RemoveTip}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource Visible}}">
                                            <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChromeClose}" />
                                        </Button>
                                        <Button x:Name="EditScriptButton"
                                                Command="{Binding EditScriptCommand}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Style.Button.Toolbar}"
                                                ToolTip="Edit Script: open its code in the script editor"
                                                Visibility="{Binding IsScript, Converter={StaticResource Visible}}">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Code}" />
                                        </Button>
                                        <!-- The Transform: 2D (X and Y, one angle) or 3D, for every entity -->
                                        <ToggleButton x:Name="ThreeDToggle"
                                                      Margin="0,0,4,0"
                                                      Padding="6,0"
                                                      VerticalAlignment="Center"
                                                      Content="3D"
                                                      DockPanel.Dock="Right"
                                                      FontSize="{StaticResource FontSize.Caption}"
                                                      IsChecked="{Binding Is3D}"
                                                      Tag="transform:3d"
                                                      ToolTip="Show the Transform in 3D: Position, Rotation and Scale in X, Y and Z. Off, it shows X and Y and one rotation angle."
                                                      Visibility="{Binding IsTransform, Converter={StaticResource Visible}}" />
                                        <!-- On a prefab copy: added there, the prefab doesn't have it -->
                                        <TextBlock x:Name="AddedMark"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   Text="Added"
                                                   ToolTip="Added to this copy: the prefab doesn't have it. Save as Prefab adds it to the prefab."
                                                   Visibility="{Binding IsAddedToCopy, Converter={StaticResource Visible}}" />
                                        <!-- Only some of the selection have it: how many, and a button that adds it to the rest -->
                                        <Button x:Name="AddToAllButton"
                                                Margin="0,0,4,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Command="{Binding AddToAllCommand}"
                                                Content="Add to All"
                                                DockPanel.Dock="Right"
                                                Tag="addall"
                                                ToolTip="{Binding PartialTip}"
                                                Visibility="{Binding IsPartial, Converter={StaticResource Visible}}" />
                                        <TextBlock x:Name="PartialNote"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   Text="{Binding PartialNote}"
                                                   ToolTip="{Binding PartialTip}"
                                                   Visibility="{Binding IsPartial, Converter={StaticResource Visible}}" />
                                        <Grid Width="20">
                                            <ToggleButton IsChecked="{Binding IsExpanded}"
                                                          Style="{StaticResource Style.TreeView.Expander}"
                                                          Visibility="{Binding IsPartial, Converter={StaticResource Hidden}}" />
                                        </Grid>
                                        <TextBlock x:Name="SectionTitle"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Style.Text.Subtitle}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Tip}"
                                                   ToolTipService.ShowDuration="60000" />
                                    </DockPanel>
                                </Border>

                                <!-- Missing component notice -->
                                <DockPanel Margin="12,8" Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
                                    <TextBlock Margin="0,1,8,0"
                                               VerticalAlignment="Top"
                                               DockPanel.Dock="Left"
                                               Foreground="{DynamicResource Brush.Status.Warning}"
                                               Style="{StaticResource Style.Icon}"
                                               Text="{x:Static theme:Icons.Warning}" />
                                    <TextBlock Style="{StaticResource Style.Text.Secondary}"
                                               Text="This component's type couldn't be found. Its data is kept and will be saved unchanged."
                                               TextWrapping="Wrap" />
                                </DockPanel>

                                <!-- What it needs and the entity doesn't have, each with a button that adds it -->
                                <ItemsControl Margin="12,8,10,0"
                                              ItemsSource="{Binding Needs}"
                                              Visibility="{Binding HasNeeds, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="inspector:NeedRow">
                                            <Border Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    BorderBrush="{DynamicResource Brush.Status.Warning}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Small}"
                                                    Tag="need">
                                                <DockPanel>
                                                    <TextBlock Margin="0,1,8,0"
                                                               VerticalAlignment="Top"
                                                               DockPanel.Dock="Left"
                                                               Foreground="{DynamicResource Brush.Status.Warning}"
                                                               Style="{StaticResource Style.Icon}"
                                                               Text="{x:Static theme:Icons.Warning}" />
                                                    <Button Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding AddCommand}"
                                                            Content="{Binding AddLabel}"
                                                            DockPanel.Dock="Right"
                                                            Tag="need:add"
                                                            ToolTip="{Binding Tip}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource Style.Text.Secondary}"
                                                               Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- How it's set up (a tilemap layer names its map) -->
                                <TextBlock Margin="12,6,10,0"
                                           Style="{StaticResource Style.Text.Caption}"
                                           Text="{Binding SetupNote}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasSetupNote, Converter={StaticResource Visible}}" />

                                <!-- A 2D Transform with values only 3D shows: which -->
                                <TextBlock x:Name="HiddenAxesNote"
                                           Margin="12,6,10,0"
                                           Style="{StaticResource Style.Text.Caption}"
                                           Tag="transform:hidden"
                                           Text="{Binding HiddenAxesNote}"
                                           TextWrapping="Wrap"
                                           ToolTip="These still count (a position's Z orders what's drawn). Switch on 3D to change them."
                                           Visibility="{Binding HasHiddenAxesNote, Converter={StaticResource Visible}}" />

                                <!-- Properties, with subheadings between them -->
                                <ItemsControl x:Name="FieldRows"
                                              Margin="12,6,10,8"
                                              Grid.IsSharedSizeScope="True"
                                              ItemsSource="{Binding Rows}"
                                              Visibility="{Binding ShowsFields, Converter={StaticResource Visible}}">
                                    <ItemsControl.Resources>
                                        <!-- A subheading ([Group]): folds the fields under it -->
                                        <DataTemplate DataType="{x:Type inspector:FieldGroup}">
                                            <DockPanel x:Name="GroupRow"
                                                       Margin="-6,8,0,2"
                                                       Background="Transparent"
                                                       Tag="group"
                                                       ToolTip="{Binding Tip}">
                                                <ToggleButton Width="18"
                                                              DockPanel.Dock="Left"
                                                              IsChecked="{Binding IsExpanded}"
                                                              Style="{StaticResource Style.TreeView.Expander}" />
                                                <TextBlock x:Name="GroupName"
                                                           Margin="2,0,8,0"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Left"
                                                           FontWeight="SemiBold"
                                                           Style="{StaticResource Style.Text.Caption}"
                                                           Background="Transparent"
                                                           Cursor="Hand"
                                                           Text="{Binding Name}">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding Command="{Binding ToggleCommand}" Gesture="LeftClick" />
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                                <Border Height="1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.Border.Subtle}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFaded}" Value="True">
                                                    <Setter TargetName="GroupName" Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFilteredOut}" Value="True">
                                                    <Setter TargetName="GroupRow" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type inspector:PropertyField}">
                                            <Grid x:Name="FieldRow" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Label" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel>
                                                    <!-- Changed from the prefab: a mark in the margin, which opens Revert and Apply to Prefab -->
                                                    <Button x:Name="OverrideMark"
                                                            Width="8"
                                                            Height="16"
                                                            Margin="-11,0,3,0"
                                                            Padding="0"
                                                            Command="{Binding OverrideMenuCommand}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                            Cursor="Hand"
                                                            DockPanel.Dock="Left"
                                                            Style="{StaticResource Style.Button.Toolbar}"
                                                            Tag="override"
                                                            ToolTip="{Binding OverrideTip}"
                                                            Visibility="Hidden">
                                                        <Border Width="3" Height="14" Background="{DynamicResource Brush.Accent}" CornerRadius="1.5" />
                                                    </Button>
                                                    <!-- The name explains the field, and drags a number -->
                                                    <TextBlock x:Name="FieldLabel"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               controls:NumberField.DragsField="True"
                                                               Background="Transparent"
                                                               Style="{StaticResource Style.Text.Secondary}"
                                                               Text="{Binding Label, Mode=OneTime}"
                                                               ToolTip="{Binding LabelTip}"
                                                               ToolTipService.ShowDuration="60000">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding Command="{Binding OverrideMenuCommand}"
                                                                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBlock}}"
                                                                          Gesture="RightClick" />
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </DockPanel>
                                                <ContentControl Grid.Column="1"
                                                                Content="{Binding}"
                                                                ContentTemplateSelector="{StaticResource FieldSelector}"
                                                                Focusable="False" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                    <Setter TargetName="OverrideMark" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="FieldLabel" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="FieldLabel" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                </DataTrigger>
                                                <!-- Only used with something that's off ([ShownWhen]): faded, still editable -->
                                                <DataTrigger Binding="{Binding IsFaded}" Value="True">
                                                    <Setter TargetName="FieldRow" Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHiddenRow}" Value="True">
                                                    <Setter TargetName="FieldRow" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <!-- Only some of the selection have it: just its name, greyed -->
                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                    <Setter TargetName="SectionTitle" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="FieldRows" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- Nothing in it matches the filter -->
                                <DataTrigger Binding="{Binding IsFilteredOut}" Value="True">
                                    <Setter TargetName="SectionRoot" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Component is the quick list; Catalog explains each component and what it needs -->
                <Grid Margin="10,12,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddComponentButton"
                            HorizontalAlignment="Stretch"
                            Click="OnAddComponentClicked"
                            PreviewMouseLeftButtonDown="OnAddComponentPressed"
                            ToolTip="Pick a component to add: type to find it, Enter adds it with whatever it needs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style.Icon}" FontSize="{StaticResource IconSize.Small}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Margin="6,0,0,0" Text="Add Component" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CatalogButton"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="OnCatalogClicked"
                            ToolTip="Browse every component: what it does, what it needs, and its properties">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style.Icon}" FontSize="{StaticResource IconSize.Small}" Text="{x:Static theme:Icons.Library}" />
                            <TextBlock Margin="6,0,0,0" Text="Catalog" />
                        </StackPanel>
                    </Button>

                    <!-- The list: type to filter, Up and Down to move, Enter (or a click) adds it with what it needs -->
                    <Popup x:Name="AddPopup"
                           AllowsTransparency="True"
                           IsOpen="{Binding IsAddOpen, Mode=TwoWay}"
                           Opened="OnAddPopupOpened"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=AddComponentButton}"
                           PopupAnimation="None"
                           StaysOpen="False"
                           VerticalOffset="2">
                        <Border x:Name="AddPanel"
                                Width="{Binding ActualWidth, ElementName=AddComponentButton}"
                                MinWidth="280"
                                DataContext="{Binding Picker}"
                                Style="{StaticResource Style.Border.Flyout}">
                            <DockPanel>
                                <Grid Margin="6,6,6,4" DockPanel.Dock="Top">
                                    <TextBox x:Name="AddSearch"
                                             Padding="24,0,6,0"
                                             PreviewKeyDown="OnAddSearchKeyDown"
                                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="8,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource IconSize.Small}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource Style.Icon}"
                                               Text="{x:Static theme:Icons.Search}" />
                                    <TextBlock Margin="25,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               IsHitTestVisible="False"
                                               Text="Type to find a component"
                                               Visibility="{Binding Text.IsEmpty, ElementName=AddSearch, Converter={StaticResource Visible}}" />
                                </Grid>

                                <!-- Browse the catalog instead -->
                                <Button x:Name="AddBrowseButton"
                                        Margin="6,0,6,6"
                                        HorizontalAlignment="Stretch"
                                        Click="OnAddBrowseClicked"
                                        Content="Browse Catalog..."
                                        DockPanel.Dock="Bottom" />

                                <!-- What Enter does: the component, with what it needs -->
                                <TextBlock x:Name="AddPlan"
                                           Margin="10,6,10,6"
                                           DockPanel.Dock="Bottom"
                                           Style="{StaticResource Style.Text.Caption}"
                                           Text="{Binding PlanText}"
                                           TextWrapping="Wrap" />

                                <Grid>
                                    <ListBox x:Name="AddList"
                                             MaxHeight="340"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             ItemsSource="{Binding View}"
                                             PreviewMouseLeftButtonUp="OnAddListClicked"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectedItem="{Binding Selected}"
                                             SelectionChanged="OnAddListSelectionChanged"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="8,8,8,2" Style="{StaticResource Style.Text.Overline}" Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="ToolTip" Value="{Binding Blurb}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="inspector:CatalogItem">
                                                <DockPanel Margin="2,1">
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               DockPanel.Dock="Right"
                                                               Foreground="{DynamicResource Brush.Status.Info}"
                                                               Style="{StaticResource Style.Text.Caption}"
                                                               Text="{Binding NeedsText}" />
                                                    <TextBlock Text="{Binding Name, Converter={x:Static inspector:HumanizeConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Margin="10,8"
                                               Style="{StaticResource Style.Text.Caption}"
                                               Text="No components match"
                                               Visibility="{Binding HasResults, Converter={StaticResource Hidden}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource Style.Text.Caption}"
                   Text="Select an entity to inspect it"
                   Visibility="{Binding HasEntity, Converter={StaticResource Hidden}}" />
    </Grid>
</UserControl>
