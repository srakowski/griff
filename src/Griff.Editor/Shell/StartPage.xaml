<UserControl x:Class="Griff.Editor.Shell.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Griff.Editor.Themes"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters">
    <Grid Background="{DynamicResource Brush.Surface.Document}">
        <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="48" Height="48"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Accent}"
                    CornerRadius="6">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.OnAccent}"
                           Text="G" />
            </Border>
            <TextBlock Margin="0,16,0,4" Style="{StaticResource Style.Text.Display}" Text="Griff" />
            <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="Make a game this weekend." />

            <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                <Button x:Name="NewButton" MinWidth="140" Style="{StaticResource Style.Button.Primary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.NewProject}" />
                        <TextBlock Margin="8,0,0,0" Text="New Project" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" Margin="8,0,0,0" MinWidth="140">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Open}" />
                        <TextBlock Margin="8,0,0,0" Text="Open Project" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="RecentHeader" Margin="0,32,0,8" Style="{StaticResource Style.Text.Overline}" Text="RECENT" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="10,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnRecentClicked"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Width="Auto"
                                Height="Auto"
                                Tag="{Binding}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding Converter={x:Static converters:PathConverters.FileName}}" />
                                <TextBlock Style="{StaticResource Style.Text.Caption}" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
