<UserControl x:Class="Griff.Editor.Features.Inspector.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:Griff.Editor.Features.Inspector"
             xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             xmlns:theme="clr-namespace:Griff.Editor.Themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:InspectorPanel}"
             d:DesignHeight="600" d:DesignWidth="320"
             AllowDrop="True"
             PreviewDragOver="OnPreviewDragOver"
             PreviewDrop="OnPreviewDrop"
             controls:NumberField.EditCompleted="OnEditCompleted">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FieldTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="Visible" />
            <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasEntity, Converter={StaticResource Visible}}">
            <StackPanel Margin="0,0,0,16">

                <!-- Entity header: the name, or with several selected, how many (their names in the tooltip) -->
                <DockPanel Margin="10,10,10,8" DataContext="{Binding Header}">
                    <CheckBox Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}"
                              ToolTip="Enabled" />
                    <Grid>
                        <controls:CommitTextBox FontSize="{StaticResource FontSize.Subtitle}"
                                                Text="{Binding Name}"
                                                Visibility="{Binding IsSeveral, Converter={StaticResource Hidden}}" />
                        <TextBlock x:Name="SeveralName"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSize.Subtitle}"
                                   Text="{Binding Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Names}"
                                   Visibility="{Binding IsSeveral, Converter={StaticResource Visible}}" />
                    </Grid>
                </DockPanel>

                <!-- A placed copy of a prefab: which one -->
                <DockPanel x:Name="PrefabNote"
                           Margin="10,0,10,8"
                           DataContext="{Binding Header}"
                           ToolTip="Saving the prefab (Entity, Save as Prefab) updates every copy of it, in every scene, keeping what each copy changed (the marked fields). Entity, Revert to Prefab undoes those changes."
                           Visibility="{Binding HasPrefabNote, Converter={StaticResource Visible}}">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource IconSize.Small}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Style="{StaticResource Style.Icon}"
                               Text="{x:Static theme:Icons.Package}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Style.Text.Caption}"
                               Text="{Binding PrefabNote}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Margin="10,0,10,8"
                           Style="{StaticResource Style.Text.Caption}"
                           Text="{Binding HiddenNote}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasHiddenNote, Converter={StaticResource Visible}}" />

                <!-- Components -->
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="inspector:ComponentSection">
                            <StackPanel>
                                <!-- Section header -->
                                <Border Padding="4,0,4,0"
                                        Background="{DynamicResource Brush.Surface.PanelHeader}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="0,1">
                                    <DockPanel Height="28">
                                        <Button Command="{Binding RemoveCommand}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Style.Button.Toolbar}"
                                                ToolTip="Remove component"
                                                Visibility="{Binding CanRemove, Converter={StaticResource Visible}}">
                                            <TextBlock FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChromeClose}" />
                                        </Button>
                                        <Button x:Name="EditScriptButton"
                                                Command="{Binding EditScriptCommand}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Style.Button.Toolbar}"
                                                ToolTip="Edit Script: open its code in the script editor"
                                                Visibility="{Binding IsScript, Converter={StaticResource Visible}}">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Accent}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Code}" />
                                        </Button>
                                        <!-- On a prefab copy: added there, the prefab doesn't have it -->
                                        <TextBlock x:Name="AddedMark"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   Text="Added"
                                                   ToolTip="Added to this copy: the prefab doesn't have it. Save as Prefab adds it to the prefab."
                                                   Visibility="{Binding IsAddedToCopy, Converter={StaticResource Visible}}" />
                                        <ToggleButton Width="20"
                                                      IsChecked="{Binding IsExpanded}"
                                                      Style="{StaticResource Style.TreeView.Expander}" />
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Style.Text.Subtitle}"
                                                   Text="{Binding Title}"
                                                   ToolTip="{Binding Tip}"
                                                   ToolTipService.ShowDuration="60000" />
                                    </DockPanel>
                                </Border>

                                <!-- Missing component notice -->
                                <DockPanel Margin="12,8" Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
                                    <TextBlock Margin="0,1,8,0"
                                               VerticalAlignment="Top"
                                               DockPanel.Dock="Left"
                                               Foreground="{DynamicResource Brush.Status.Warning}"
                                               Style="{StaticResource Style.Icon}"
                                               Text="{x:Static theme:Icons.Warning}" />
                                    <TextBlock Style="{StaticResource Style.Text.Secondary}"
                                               Text="This component's type couldn't be found. Its data is kept and will be saved unchanged."
                                               TextWrapping="Wrap" />
                                </DockPanel>

                                <!-- How it's set up (a tilemap layer names its map) -->
                                <TextBlock Margin="12,6,10,0"
                                           Style="{StaticResource Style.Text.Caption}"
                                           Text="{Binding SetupNote}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasSetupNote, Converter={StaticResource Visible}}" />

                                <!-- Properties -->
                                <ItemsControl Margin="12,6,10,8"
                                              Grid.IsSharedSizeScope="True"
                                              ItemsSource="{Binding Properties}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="inspector:PropertyField">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Label" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel>
                                                    <!-- Changed from the prefab: a mark in the margin, which opens Revert and Apply to Prefab -->
                                                    <Button x:Name="OverrideMark"
                                                            Width="8"
                                                            Height="16"
                                                            Margin="-11,0,3,0"
                                                            Padding="0"
                                                            Command="{Binding OverrideMenuCommand}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                            Cursor="Hand"
                                                            DockPanel.Dock="Left"
                                                            Style="{StaticResource Style.Button.Toolbar}"
                                                            Tag="override"
                                                            ToolTip="{Binding OverrideTip}"
                                                            Visibility="Hidden">
                                                        <Border Width="3" Height="14" Background="{DynamicResource Brush.Accent}" CornerRadius="1.5" />
                                                    </Button>
                                                    <!-- The name explains the field, and drags a number -->
                                                    <TextBlock x:Name="FieldLabel"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               controls:NumberField.DragsField="True"
                                                               Background="Transparent"
                                                               Style="{StaticResource Style.Text.Secondary}"
                                                               Text="{Binding Label, Mode=OneTime}"
                                                               ToolTip="{Binding LabelTip}"
                                                               ToolTipService.ShowDuration="60000">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding Command="{Binding OverrideMenuCommand}"
                                                                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBlock}}"
                                                                          Gesture="RightClick" />
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </DockPanel>
                                                <ContentControl Grid.Column="1"
                                                                Content="{Binding}"
                                                                ContentTemplateSelector="{StaticResource FieldSelector}"
                                                                Focusable="False" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                    <Setter TargetName="OverrideMark" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="FieldLabel" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="FieldLabel" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Component is the quick list; Catalog explains each component and what it needs -->
                <Grid Margin="10,12,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddComponentButton" HorizontalAlignment="Stretch" Click="OnAddComponentClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style.Icon}" FontSize="{StaticResource IconSize.Small}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Margin="6,0,0,0" Text="Add Component" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CatalogButton"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="OnCatalogClicked"
                            ToolTip="Browse every component: what it does, what it needs, and its properties">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style.Icon}" FontSize="{StaticResource IconSize.Small}" Text="{x:Static theme:Icons.Library}" />
                            <TextBlock Margin="6,0,0,0" Text="Catalog" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource Style.Text.Caption}"
                   Text="Select an entity to inspect it"
                   Visibility="{Binding HasEntity, Converter={StaticResource Hidden}}" />
    </Grid>
</UserControl>
