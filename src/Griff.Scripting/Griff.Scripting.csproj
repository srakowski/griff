<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiling a project's scripts and loading them into a game (ScriptCompiler, ScriptHost): all a game played from its
    sources and the exporter need, so only Roslyn's compiler. The editor's language services (Workspaces, Features) and
    its debugger's instrumenter are the editor's (Features/Scripts/Language, Features/Debugging/Probes); exporting is
    Griff.Exporting's, on this. AssemblySplitTests keeps it so.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Griff\Griff.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
