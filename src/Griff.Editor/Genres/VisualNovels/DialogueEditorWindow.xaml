<controls:ChromeWindow x:Class="Griff.Editor.Genres.VisualNovels.DialogueEditorWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:story="clr-namespace:Griff.Editor.Genres.VisualNovels"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       mc:Ignorable="d"
                       d:DataContext="{d:DesignInstance Type=story:DialogueEditor}"
                       Title="Dialogue Editor"
                       Width="1060"
                       Height="720"
                       MinWidth="760"
                       MinHeight="520"
                       ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="Visible" />
        <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />

        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Overline}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style x:Key="Pick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Surface.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Whose lines these are -->
        <DockPanel Margin="16,12,16,0">
            <Button x:Name="CloseButton" Click="OnClose" Content="Close" DockPanel.Dock="Right" IsCancel="True" Style="{StaticResource Small}" ToolTip="Close the Dialogue Editor (Esc)" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Lines of" />
            <TextBlock x:Name="EntityName" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding EntityName}" />
        </DockPanel>

        <!-- Why there's nothing (or not everything) to show -->
        <Border x:Name="NoticeBar"
                Grid.Row="1"
                Margin="16,8,16,0"
                Padding="10,6"
                Background="{DynamicResource Brush.Surface.Document}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Medium}"
                Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Status.Info}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Info}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Notice}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,12,16,14" Visibility="{Binding HasDialogue, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The lines -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Lines" />
                <WrapPanel x:Name="LineButtons" Margin="0,8,0,0" DockPanel.Dock="Bottom">
                    <Button x:Name="AddLineButton" Command="{Binding AddLineCommand}" Style="{StaticResource Small}" ToolTip="Add a line after this one">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Text="Add Line" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveLineButton" Command="{Binding RemoveLineCommand}" Style="{StaticResource Small}" ToolTip="Remove this line">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoveUpButton" Command="{Binding MoveUpCommand}" Content="Up" Style="{StaticResource Small}" ToolTip="Move this line up" />
                    <Button x:Name="MoveDownButton" Command="{Binding MoveDownCommand}" Content="Down" Style="{StaticResource Small}" ToolTip="Move this line down" />
                    <Button x:Name="AddChoiceButton" Command="{Binding AddChoiceCommand}" Content="Add Choice" Style="{StaticResource Small}" ToolTip="Add a choice after this line: it's offered under the line before it" />
                    <Button x:Name="AddPartButton" Command="{Binding AddPartCommand}" Content="Add Part" Style="{StaticResource Small}" ToolTip="Start a part after this line, which choices and go-tos can go to" />
                    <Button x:Name="AddGoToButton" Command="{Binding AddGoToCommand}" Content="Add Go To" Style="{StaticResource Small}" ToolTip="Go to a part (or end) after this line" />
                </WrapPanel>
                <ListBox x:Name="LineList" ItemsSource="{Binding Lines}" SelectedIndex="{Binding SelectedIndex}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="story:LineRow">
                            <DockPanel Margin="2,3">
                                <TextBlock Width="26" VerticalAlignment="Top" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding Number}" />
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Margin="8,0,0,0" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding Kind}" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Who}" Visibility="{Binding HasWho, Converter={StaticResource Visible}}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Said}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasSaid, Converter={StaticResource Visible}}" />
                                    <TextBlock FontSize="11" Style="{StaticResource Style.Text.Secondary}" Text="{Binding Directions}" TextWrapping="Wrap" Visibility="{Binding HasDirections, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The line picked, and the stage it leaves -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Line" />

                <Grid x:Name="LineFields" DockPanel.Dock="Top" IsEnabled="{Binding HasLine}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Label}" Text="Said by" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanHaveSpeaker}">
                        <ComboBox x:Name="SpeakerBox" ItemsSource="{Binding Speakers}" SelectedItem="{Binding Speaker}" Style="{StaticResource Pick}" ToolTip="Who says the line: their name and the box's name tag" />
                        <TextBlock Style="{StaticResource Label}" Text="looking" />
                        <ComboBox x:Name="ExpressionBox" ItemsSource="{Binding Expressions}" SelectedItem="{Binding Expression}" Style="{StaticResource Pick}" ToolTip="The expression they say it with: their face changes on stage" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Says" />
                    <TextBox x:Name="SaidBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Said, UpdateSourceTrigger=LostFocus}" ToolTip="What's said: Enter or leaving the box keeps it" KeyDown="OnTextKeyDown" />

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="As written" />
                    <TextBox x:Name="RowBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Style="{StaticResource Style.TextBox.Code}" Text="{Binding RowText, UpdateSourceTrigger=LostFocus}" ToolTip="The whole line as it's written in the dialogue's Lines, tags and all" KeyDown="OnTextKeyDown" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Goes to" Visibility="{Binding CanGoTo, Converter={StaticResource Visible}}" />
                    <ComboBox x:Name="GoesToBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding GoToChoices}" SelectedItem="{Binding GoesTo}" Style="{StaticResource Pick}"
                              ToolTip="Where it goes when it's picked (a choice) or reached (a go-to): one of the dialogue's parts, or End" Visibility="{Binding CanGoTo, Converter={StaticResource Visible}}" />
                </Grid>

                <!-- Its flags and messages -->
                <TextBlock Margin="0,8,0,6" DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Flags and messages" />
                <ItemsControl x:Name="TagList" DockPanel.Dock="Top" ItemsSource="{Binding StoryTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="story:StoryTagRow">
                            <DockPanel Margin="0,0,0,4">
                                <Button Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Style.Button.Toolbar}"
                                        ToolTip="Remove this">
                                    <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                                </Button>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Description}" ToolTip="{Binding Tag}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel x:Name="NewTag" Margin="0,2,0,0" DockPanel.Dock="Top" IsEnabled="{Binding CanHaveTags}">
                    <ComboBox x:Name="TagKindBox" ItemsSource="{Binding TagKinds}" SelectedItem="{Binding NewTagKind}" Style="{StaticResource Pick}" MinWidth="80"
                              ToolTip="if: said only while the flag is set; if not: only while it isn't; set and clear: the flag, when it's said; send: a message, when it's said" />
                    <TextBox x:Name="TagNameBox" Width="150" Margin="0,0,2,6" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" ToolTip="The flag (one the project sets, or a new one) or the message" />
                    <ComboBox x:Name="TagNamePick" Width="26" Margin="0,0,8,6" ItemsSource="{Binding NewTagNames}" SelectedItem="{Binding NewTagPick}" ToolTip="Pick a flag the project sets, or a message it sends or hears" />
                    <Button x:Name="AddTagButton" Command="{Binding AddTagCommand}" Style="{StaticResource Small}" Margin="0,0,0,6" ToolTip="Add this to the line">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Its stage directions -->
                <TextBlock Margin="0,8,0,6" DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Stage directions" />
                <ItemsControl x:Name="DirectionList" DockPanel.Dock="Top" ItemsSource="{Binding Directions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="story:DirectionRow">
                            <DockPanel Margin="0,0,0,4">
                                <Button Command="{Binding DataContext.RemoveDirectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Style.Button.Toolbar}"
                                        ToolTip="Remove this direction">
                                    <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                                </Button>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Description}" ToolTip="{Binding Tag}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel x:Name="NewDirection" Margin="0,2,0,0" DockPanel.Dock="Top" IsEnabled="{Binding HasLine}">
                    <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" Style="{StaticResource Pick}" MinWidth="96" ToolTip="What it does" />
                    <ComboBox x:Name="WhoBox" ItemsSource="{Binding Characters}" SelectedItem="{Binding NewWho}" Style="{StaticResource Pick}" ToolTip="Who it's for"
                              Visibility="{Binding IsNewBackground, Converter={StaticResource Hidden}}" />
                    <ComboBox x:Name="PositionBox" ItemsSource="{Binding Positions}" SelectedItem="{Binding NewPosition}" Style="{StaticResource Pick}" ToolTip="Where they stand (empty leaves it)"
                              Visibility="{Binding IsNewBackground, Converter={StaticResource Hidden}}" />
                    <ComboBox x:Name="NewExpressionBox" ItemsSource="{Binding NewExpressions}" SelectedItem="{Binding NewExpression}" Style="{StaticResource Pick}" ToolTip="How they look (empty leaves it)"
                              Visibility="{Binding IsNewBackground, Converter={StaticResource Hidden}}" />
                    <ComboBox x:Name="BackgroundBox" ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding NewBackground}" Style="{StaticResource Pick}" ToolTip="The background to change to"
                              Visibility="{Binding IsNewBackground, Converter={StaticResource Visible}}" />
                    <ComboBox x:Name="TransitionBox" ItemsSource="{Binding Transitions}" SelectedItem="{Binding NewTransition}" Style="{StaticResource Pick}" MinWidth="80" ToolTip="How it happens: as the stage does, cut, fade or slide" />
                    <Button x:Name="AddDirectionButton" Command="{Binding AddDirectionCommand}" Style="{StaticResource Small}" Margin="0,0,0,6" ToolTip="Add this direction to the line">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Text="Add Direction" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="ProblemsText"
                           Margin="0,4,0,0"
                           DockPanel.Dock="Top"
                           Foreground="{DynamicResource Brush.Status.Warning}"
                           Text="{Binding Problems}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasProblems, Converter={StaticResource Visible}}" />

                <!-- The stage at this line -->
                <TextBlock Margin="0,10,0,6" DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Stage at this line" />
                <TextBlock x:Name="PreviewText" Margin="0,6,0,0" DockPanel.Dock="Bottom" Style="{StaticResource Style.Text.Secondary}" Text="{Binding PreviewText}" TextWrapping="Wrap" />
                <Border x:Name="Preview"
                        Background="{DynamicResource Brush.Surface.Document}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Visibility="{Binding HasStage, Converter={StaticResource Visible}}">
                    <Viewbox Margin="8" Stretch="Uniform">
                        <Canvas Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" ClipToBounds="True" Background="{Binding PreviewBackground}">
                            <ItemsControl ItemsSource="{Binding PreviewFigures}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="story:PreviewFigure">
                                        <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Name}">
                                            <Rectangle Fill="{Binding Fill}" />
                                            <Image RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Image}" Stretch="Fill" />
                                            <Rectangle Fill="Black" Opacity="{Binding Dim}" OpacityMask="{Binding Mask}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The box along the bottom, as the game shows it -->
                            <Border Canvas.Bottom="12"
                                    Canvas.Left="24"
                                    Width="{Binding PreviewWidth}"
                                    Padding="14,8"
                                    Background="#E0161920"
                                    CornerRadius="6">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.94" />
                                </Border.RenderTransform>
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#E3B341" Text="{Binding PreviewSpeaker}" />
                                    <TextBlock FontSize="22" Foreground="White" Text="{Binding PreviewSaid}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Viewbox>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</controls:ChromeWindow>
