<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Griff\Griff.csproj" />
    <ProjectReference Include="..\Griff.Platform.Windows\Griff.Platform.Windows.csproj" />
    <ProjectReference Include="..\Griff.Scripting\Griff.Scripting.csproj" />
    <ProjectReference Include="..\Griff.Exporting\Griff.Exporting.csproj" />
    <ProjectReference Include="..\Griff.Editing\Griff.Editing.csproj" />
    <ProjectReference Include="..\Griff.Agent\Griff.Agent.csproj" />
    <!-- Every module, running and editor parts, beside the editor: it plays them, exports them and edits with them. -->
    <ProjectReference Include="..\Modules\Griff.Modules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script editor's language services (Features/Scripts/Language): completions, diagnostics, quick info, renames. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The installer and its updates (MIT; see Features/Updates and tools/release.ps1). -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- JetBrains Mono, the code font (SIL Open Font License 1.1: free to embed and ship; see Themes/Fonts/JetBrainsMono-OFL.txt). -->
  <ItemGroup>
    <Resource Include="Themes\Fonts\*.ttf" />
    <None Include="Themes\Fonts\JetBrainsMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The free fonts that ship with Griff for games (SIL Open Font License 1.1, unmodified, with their licenses; see
    src/Griff.Fonts/Free/README.md), beside the editor in FreeFonts: the font picker copies one into a project's Assets
    when it's picked. They're never inside the player.
  -->
  <ItemGroup>
    <None Include="..\Griff.Fonts\Free\*.ttf;..\Griff.Fonts\Free\*.txt" Link="FreeFonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The griffin logo (drawn by tools\logo.ps1): the .exe's icon, and the title bar's and start page's mark. -->
  <ItemGroup>
    <Resource Include="..\..\assets\griff.png" Link="Themes\griff.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\assets\griff.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Commands' /// summaries describe them to agents (see Features/Agent); not every public member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419;CS1574;CS1584;CS1658</NoWarn>
    <!-- The player is self-contained; the editor isn't. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- Program.Main runs Velopack (the installer and its updates) before the application starts. -->
    <StartupObject>Griff.Editor.Program</StartupObject>
    <!--
      A build from source is "-dev" (and its title says just "Griff"). A release is built with its tag's version
      (tools\release.ps1 passes -p:Version=0.1.0-alpha.1), which replaces this.
    -->
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <!-- Ship the game players next to the editor so Build Game and Build for Web can export them. -->
  <ItemGroup>
    <ProjectReference Include="..\Griff.Player\Griff.Player.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    Build Game copies a single-file player and packs the game onto its end. Two kinds ship with the editor:
    Standalone carries its own .NET (one big file, nothing to install), Small needs the .NET Desktop Runtime. Build for
    Web copies the web player (Griff.Web, published in Release, without the compressed copies static hosts don't need)
    from Player\Web\wwwroot and puts the game beside it.
    Each publishes from its own output folders so the two don't trip over each other. tools/docs.cs builds the editor with
    -p:SkipPlayers=true: it needs the editor's services, not the players.
  -->
  <Target Name="PublishPlayers" AfterTargets="Build" Condition="'$(SkipPlayers)' != 'true'">
    <MSBuild Projects="..\Griff.Player\Griff.Player.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PlayerKind=Standalone;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;DebugType=none;SatelliteResourceLanguages=en;OutputPath=bin\$(Configuration)\Standalone\;IntermediateOutputPath=obj\$(Configuration)\Standalone\;PublishDir=$(MSBuildProjectDirectory)\$(OutDir)Player\Standalone\" />
    <MSBuild Projects="..\Griff.Player\Griff.Player.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PlayerKind=Small;SelfContained=false;PublishSingleFile=true;DebugType=none;SatelliteResourceLanguages=en;OutputPath=bin\$(Configuration)\Small\;IntermediateOutputPath=obj\$(Configuration)\Small\;PublishDir=$(MSBuildProjectDirectory)\$(OutDir)Player\Small\" />
    <!-- Griff.Web isn't a ProjectReference (building it for the editor's own configuration is wasted work), so nothing else restores it: a clean clone would fail without this. A no-op when already restored. -->
    <MSBuild Projects="..\Griff.Web\Griff.Web.csproj" Targets="Restore" Properties="MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="..\Griff.Web\Griff.Web.csproj" Targets="Publish" Properties="Configuration=Release;CompressionEnabled=false;OutputPath=bin\Release\Editor\;IntermediateOutputPath=obj\Release\Editor\;PublishDir=$(MSBuildProjectDirectory)\$(OutDir)Player\Web\" />
  </Target>

</Project>
