<!-- A field's list (its FieldPicker): type to narrow it, Up and Down to move, Enter or a click to pick -->
<UserControl x:Class="Griff.Editor.Features.Inspector.FieldPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:Griff.Editor.Features.Inspector"
             xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
             xmlns:theme="clr-namespace:Griff.Editor.Themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:FieldPicker}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="Visible" />
        <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
    </UserControl.Resources>

    <Border Style="{StaticResource Style.Border.Flyout}">
        <DockPanel>
            <Grid Margin="6,6,6,4" DockPanel.Dock="Top">
                <TextBox x:Name="Search"
                         Padding="24,0,6,0"
                         PreviewKeyDown="OnSearchKeyDown"
                         Tag="picker:search"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="8,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource IconSize.Small}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                           IsHitTestVisible="False"
                           Style="{StaticResource Style.Icon}"
                           Text="{x:Static theme:Icons.Search}" />
                <TextBlock Margin="25,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                           IsHitTestVisible="False"
                           Text="{Binding Placeholder, Mode=OneTime}"
                           Visibility="{Binding Text.IsEmpty, ElementName=Search, Converter={StaticResource Visible}}" />
            </Grid>

            <!-- What else it does: paint or make one, or clear the field -->
            <ItemsControl Margin="0,0,0,4"
                          DockPanel.Dock="Bottom"
                          ItemsSource="{Binding Actions, Mode=OneTime}"
                          Visibility="{Binding HasActions, Mode=OneTime, Converter={StaticResource Visible}}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <StackPanel>
                            <Border Height="1" Margin="0,2,0,4" Background="{DynamicResource Brush.Border.Default}" />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspector:PickerAction">
                        <Button Margin="4,0"
                                Padding="6,3"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnActionClicked"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Tag="{Binding Tag, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="16" FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{Binding Icon, Mode=OneTime}" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding Label, Mode=OneTime}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A name that isn't in the list, used as typed -->
            <Button Margin="4,0,4,2"
                    Padding="6,3"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnUseTypedClicked"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="picker:typed"
                    ToolTip="Use the name as it's typed: Enter does this when nothing in the list matches"
                    Visibility="{Binding HasTypedOffer, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="16" FontSize="{StaticResource IconSize.Small}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding TypedOffer}" />
                </StackPanel>
            </Button>

            <Grid>
                <ListBox x:Name="List"
                         MaxHeight="300"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         ItemsSource="{Binding Matches}"
                         PreviewMouseLeftButtonUp="OnListClicked"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding Selected}"
                         SelectionChanged="OnListSelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Tag" Value="{Binding Name, Mode=OneTime}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="inspector:PickerChoice">
                            <DockPanel Margin="0,1">
                                <!-- Ticked when the field names it now -->
                                <TextBlock x:Name="Tick"
                                           Width="16"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left"
                                           FontSize="{StaticResource IconSize.Small}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Style="{StaticResource Style.Icon}"
                                           Text="{x:Static theme:Icons.CheckMark}"
                                           Visibility="Hidden" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Style="{StaticResource Style.Text.Caption}"
                                           Text="{Binding Detail, Mode=OneTime}" />
                                <StackPanel Margin="{Binding Indent, Mode=OneTime}" Orientation="Horizontal">
                                    <Image Width="16" Height="16"
                                           Margin="0,0,6,0"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Source="{Binding Thumbnail, Mode=OneTime}"
                                           Stretch="Uniform"
                                           Visibility="{Binding HasThumbnail, Mode=OneTime, Converter={StaticResource Visible}}" />
                                    <TextBlock x:Name="Icon"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource IconSize.Small}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Style="{StaticResource Style.Icon}"
                                               Text="{Binding Icon, Mode=OneTime}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon, Mode=OneTime}" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="10,8"
                           Style="{StaticResource Style.Text.Caption}"
                           Text="{Binding Note}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
