<controls:ChromeWindow x:Class="Griff.Editor.Features.Controls.ControlsWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:local="clr-namespace:Griff.Editor.Features.Controls"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       mc:Ignorable="d"
                       d:DataContext="{d:DesignInstance Type=local:ControlsViewModel}"
                       Title="Controls"
                       Width="860"
                       Height="600"
                       MinWidth="680"
                       MinHeight="460"
                       ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="Visible" />
        <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />

        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Overline}">
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- Text that only shows when there's something to say -->
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- A key or button on the action: its name, a × to take it off, and a note if another action has it too -->
        <DataTemplate x:Key="Chip" DataType="local:BindingChip">
            <StackPanel Margin="0,0,6,6" ToolTip="{Binding Tip}">
                <Border Height="30"
                        Padding="10,0,2,0"
                        Background="{DynamicResource Brush.Surface.Document}"
                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text}" />
                        <Button Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Command="{Binding RemoveCommand}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Tag="chip:remove">
                            <TextBlock FontSize="9" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChromeClose}" />
                        </Button>
                    </StackPanel>
                </Border>
                <TextBlock Margin="2,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Status.Warning}"
                           Style="{StaticResource Note}"
                           Text="{Binding AlsoDoes}" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Surface.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Every action the game has -->
        <DockPanel x:Name="ActionPanel" Margin="16,4,0,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Actions" />
            <TextBlock x:Name="MoveNote"
                       Margin="0,10,0,0"
                       DockPanel.Dock="Bottom"
                       Style="{StaticResource Note}"
                       Text="Moving (Input.Move) always uses WASD, the arrow keys, the D-pad and the left stick." />
            <Button x:Name="AddActionButton"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddActionCommand}"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource AddButton}"
                    ToolTip="A new action of the game's own, for scripts to read">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                    <TextBlock Text="Add Action" />
                </StackPanel>
            </Button>
            <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:ActionRow">
                        <StackPanel Margin="2,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Text="changed"
                                           ToolTip="Not Griff's usual keys and buttons"
                                           Visibility="{Binding IsChanged, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The selected action -->
        <ScrollViewer x:Name="Details" Grid.Column="1" Margin="24,4,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Style="{StaticResource Heading}" Text="Name" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NameBox"
                             Width="220"
                             DataContext="{Binding DataContext, ElementName=ActionList}"
                             IsReadOnly="{Binding Selected.IsBuiltIn}"
                             Text="{Binding EditName}" />
                    <Border x:Name="BuiltInTag"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}"
                            ToolTip="One of Griff's own actions: change its keys and buttons, but it keeps its name"
                            Visibility="{Binding IsBuiltIn, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="Built in" />
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           DataContext="{Binding DataContext, ElementName=ActionList}"
                           Foreground="{DynamicResource Brush.Status.Error}"
                           Style="{StaticResource Note}"
                           Text="{Binding NameError}" />
                <TextBlock x:Name="UsedByText" Margin="0,8,0,0" Style="{StaticResource Note}" Text="{Binding UsedBy}" />

                <TextBlock Style="{StaticResource Heading}" Text="Keyboard and mouse" />
                <WrapPanel x:Name="KeyPanel">
                    <ItemsControl x:Name="KeyChips" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource Wrap}" ItemsSource="{Binding Keys}" />
                    <Button x:Name="ListenKeyButton"
                            Command="{Binding DataContext.ListenForKeyCommand, ElementName=ActionList}"
                            Style="{StaticResource AddButton}"
                            ToolTip="Press a key, or click this with a mouse button, to add it">
                        <Grid DataContext="{Binding DataContext, ElementName=ActionList}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsListeningForKey, Converter={StaticResource Hidden}}">
                                <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                                <TextBlock Text="Press a Key" />
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                       Text="Press a key or click here with a mouse button (Esc cancels)"
                                       Visibility="{Binding IsListeningForKey, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Button>
                </WrapPanel>

                <TextBlock Style="{StaticResource Heading}" Text="Gamepad" />
                <WrapPanel x:Name="PadPanel">
                    <ItemsControl x:Name="PadChips" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource Wrap}" ItemsSource="{Binding Pads}" />
                    <Button x:Name="AddPadButton" Click="OnAddPad" Style="{StaticResource AddButton}" ToolTip="Pick a controller button (no controller needed)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Text="Add Button" />
                            <TextBlock Margin="6,0,0,0" FontSize="9" VerticalAlignment="Center" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChevronDown}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ListenPadButton"
                            Command="{Binding DataContext.ListenForPadCommand, ElementName=ActionList}"
                            Style="{StaticResource AddButton}"
                            ToolTip="Press a button on a connected controller to add it">
                        <Grid DataContext="{Binding DataContext, ElementName=ActionList}">
                            <TextBlock Text="Press on Controller" Visibility="{Binding IsListeningForPad, Converter={StaticResource Hidden}}" />
                            <TextBlock Foreground="{DynamicResource Brush.Accent}"
                                       Text="Press a controller button (Esc cancels)"
                                       Visibility="{Binding IsListeningForPad, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="PlayerChoiceText"
                           Margin="0,12,0,0"
                           DataContext="{Binding DataContext, ElementName=ActionList}"
                           Foreground="{DynamicResource Brush.Status.Warning}"
                           Style="{StaticResource Note}"
                           Text="{Binding PlayerChoice}" />

                <TextBlock Style="{StaticResource Heading}" Text="In scripts" />
                <TextBox x:Name="CodeText"
                         HorizontalAlignment="Left"
                         FontFamily="{DynamicResource Font.Mono}"
                         IsReadOnly="True"
                         Text="{Binding Code, Mode=OneWay}"
                         ToolTip="Copy it into a script" />

                <StackPanel Margin="0,22,0,12" Orientation="Horizontal" DataContext="{Binding DataContext, ElementName=ActionList}">
                    <Button x:Name="ResetButton"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource AddButton}"
                            ToolTip="Put back Griff's keys and buttons for this action"
                            Visibility="{Binding Selected.IsBuiltIn, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Undo}" />
                            <TextBlock Text="Reset to Default" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource AddButton}"
                            Visibility="{Binding Selected.IsBuiltIn, Converter={StaticResource Hidden}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                            <TextBlock Text="Delete Action" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Saved as you go -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="16,12,16,14">
            <Button x:Name="CloseButton" Width="80" Click="OnClose" Content="Close" DockPanel.Dock="Right" />
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Style="{StaticResource Style.Text.Secondary}"
                       Text="{Binding Status, TargetNullValue='Changes are saved in project.griff as you make them, and reach the running game straight away.'}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</controls:ChromeWindow>
