{
  "columns": [
    { "name": "Level", "type": "whole number" },
    { "name": "Base Health", "type": "number" },
    { "name": "Growth", "type": "number" },
    { "name": "Health", "type": "number", "formula": "=[Base Health] + Growth * (Level - 1)" },
