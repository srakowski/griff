<!-- The Inspector's property editors, one per FieldKind, shared with the script editor's component panel. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inspector="clr-namespace:Griff.Editor.Features.Inspector"
                    xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                    xmlns:theme="clr-namespace:Griff.Editor.Themes"
                    xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters">

    <!-- Fields with editors of their own (FieldEditor): each editor's template, by its type -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FieldEditors/FieldEditorTemplates.xaml" />
        <ResourceDictionary Source="FieldEditors/GameplayEditorTemplates.xaml" />
        <ResourceDictionary Source="FieldEditors/RowEditorTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:BoolToVisibilityConverter x:Key="Field.Visible" />

    <!-- A field with an editor of its own: the editor, shown by its own template -->
    <DataTemplate x:Key="Field.Custom" DataType="inspector:PropertyField">
        <ContentControl Content="{Binding Editor, Mode=OneTime}" Focusable="False" />
    </DataTemplate>

    <DataTemplate x:Key="Field.Bool" DataType="inspector:PropertyField">
        <CheckBox HorizontalAlignment="Left" IsChecked="{Binding BoolValue}" />
    </DataTemplate>

    <DataTemplate x:Key="Field.Number" DataType="inspector:PropertyField">
        <controls:NumberField IsInteger="{Binding IsInteger, Mode=OneTime}" IsMixed="{Binding IsMixed, Mode=OneWay}" Value="{Binding NumberValue}" />
    </DataTemplate>

    <DataTemplate x:Key="Field.Text" DataType="inspector:PropertyField">
        <controls:CommitTextBox Text="{Binding TextValue}" />
    </DataTemplate>

    <!-- Sounds and music: the file, with buttons to play it, choose one from the project, or make one -->
    <DataTemplate x:Key="Field.Sound" DataType="inspector:PropertyField">
        <DockPanel x:Name="Row">
            <inspector:FieldPickerPopup DockPanel.Dock="Right" PlacementTarget="{Binding ElementName=Row}" />
            <Button x:Name="MakeButton"
                    Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding MakeSoundCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="sound:make"
                    ToolTip="{Binding SoundTip}">
                <TextBlock x:Name="MakeIcon" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Audio}" />
            </Button>
            <Button Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding TogglePickerCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="sound:choose"
                    ToolTip="{Binding PickerTip, Mode=OneTime}">
                <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChevronDown}" />
            </Button>
            <Button Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding PreviewSoundCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="sound:play"
                    ToolTip="Play it">
                <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Play}" />
            </Button>
            <controls:CommitTextBox x:Name="Path" Text="{Binding TextValue}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMusic, Mode=OneTime}" Value="True">
                <Setter TargetName="MakeIcon" Property="Text" Value="{x:Static theme:Icons.Music}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSoundMissing}" Value="True">
                <Setter TargetName="Path" Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                <Setter TargetName="Path" Property="ToolTip" Value="There's no such file in the project's Assets" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Images: a preview and the file, with buttons to choose one from the project, or paint one -->
    <DataTemplate x:Key="Field.Image" DataType="inspector:PropertyField">
        <DockPanel x:Name="Row">
            <inspector:FieldPickerPopup DockPanel.Dock="Right" PlacementTarget="{Binding ElementName=Row}" />
            <Border Width="22" Height="22"
                    Margin="0,0,6,0"
                    Background="{DynamicResource Brush.Surface.Document}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Small}"
                    DockPanel.Dock="Left">
                <Image Margin="1" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding ImagePreview}" Stretch="Uniform" />
            </Border>
            <Button Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding PaintImageCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="image:paint"
                    ToolTip="{Binding ImageTip}">
                <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Palette}" />
            </Button>
            <Button Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding TogglePickerCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="image:choose"
                    ToolTip="{Binding PickerTip, Mode=OneTime}">
                <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChevronDown}" />
            </Button>
            <controls:CommitTextBox x:Name="Path" Text="{Binding TextValue}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsImageMissing}" Value="True">
                <Setter TargetName="Path" Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                <Setter TargetName="Path" Property="ToolTip" Value="There's no such file in the project's Assets" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Entity names: the name, with a button to pick one from the scene; entities drop on it from the Hierarchy -->
    <DataTemplate x:Key="Field.Entity" DataType="inspector:PropertyField">
        <DockPanel x:Name="Row">
            <inspector:FieldPickerPopup DockPanel.Dock="Right" PlacementTarget="{Binding ElementName=Row}" />
            <Button Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding TogglePickerCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="entity:choose"
                    ToolTip="{Binding PickerTip, Mode=OneTime}">
                <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChevronDown}" />
            </Button>
            <!-- A name that matches nothing: a warning sign, saying which -->
            <TextBlock x:Name="Unmatched"
                       Margin="4,0,2,0"
                       VerticalAlignment="Center"
                       Background="Transparent"
                       DockPanel.Dock="Right"
                       Foreground="{DynamicResource Brush.Status.Warning}"
                       Style="{StaticResource Style.Icon}"
                       Tag="entity:unmatched"
                       Text="{x:Static theme:Icons.Warning}"
                       ToolTip="{Binding UnmatchedTip}"
                       Visibility="Collapsed" />
            <controls:CommitTextBox x:Name="Name" Text="{Binding TextValue}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                <Setter TargetName="Unmatched" Property="Visibility" Value="Visible" />
                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                <Setter TargetName="Name" Property="ToolTip" Value="{Binding UnmatchedTip}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Names of prefabs, scenes, input actions, layers and messages: the name, with a button to pick one of the project's -->
    <DataTemplate x:Key="Field.Name" DataType="inspector:PropertyField">
        <DockPanel x:Name="Row">
            <inspector:FieldPickerPopup DockPanel.Dock="Right" PlacementTarget="{Binding ElementName=Row}" />
            <Button Width="24"
                    Margin="2,0,0,0"
                    Command="{Binding TogglePickerCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Toolbar}"
                    Tag="name:choose"
                    ToolTip="{Binding PickerTip, Mode=OneTime}">
                <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.ChevronDown}" />
            </Button>
            <!-- A name that matches nothing: a warning sign, saying which -->
            <TextBlock x:Name="Unmatched"
                       Margin="4,0,2,0"
                       VerticalAlignment="Center"
                       Background="Transparent"
                       DockPanel.Dock="Right"
                       Foreground="{DynamicResource Brush.Status.Warning}"
                       Style="{StaticResource Style.Icon}"
                       Tag="name:unmatched"
                       Text="{x:Static theme:Icons.Warning}"
                       ToolTip="{Binding UnmatchedTip}"
                       Visibility="Collapsed" />
            <controls:CommitTextBox x:Name="Name" Text="{Binding TextValue}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                <Setter TargetName="Unmatched" Property="Visibility" Value="Visible" />
                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                <Setter TargetName="Name" Property="ToolTip" Value="{Binding UnmatchedTip}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Lists of strings, one per line (tilemap rows): monospace so columns line up -->
    <DataTemplate x:Key="Field.Lines" DataType="inspector:PropertyField">
        <controls:CommitTextBox MinHeight="44"
                                MaxHeight="220"
                                AcceptsReturn="True"
                                FontFamily="{StaticResource Font.Mono}"
                                HorizontalScrollBarVisibility="Auto"
                                Text="{Binding LinesValue}"
                                TextWrapping="NoWrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto" />
    </DataTemplate>

    <!-- Choices named as they read ("Ping Pong"), each explained in its tooltip. The pick is set just after the click is
         done (Delay), since a choice can change which fields show (a tilemap's Shape) and remake the section, and with it
         this box, which mustn't happen while the box is still selecting. -->
    <DataTemplate x:Key="Field.Enum" DataType="inspector:PropertyField">
        <ComboBox ItemsSource="{Binding EnumChoices, Mode=OneTime}" SelectedValue="{Binding EnumValue, Delay=1}" SelectedValuePath="Value">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="inspector:EnumChoice">
                    <TextBlock Text="{Binding Label, Mode=OneTime}" ToolTip="{Binding Tip, Mode=OneTime}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <!-- Colors: the swatch opens the picker (hue and value, alpha, palette, recent colors); the hex can be typed -->
    <DataTemplate x:Key="Field.Color" DataType="inspector:PropertyField">
        <DockPanel x:Name="Row">
            <inspector:ColorPickerPopup PlacementTarget="{Binding ElementName=Row}" />
            <Button Width="22" Height="22"
                    MinWidth="0" MinHeight="0"
                    Margin="0,0,6,0"
                    Padding="0"
                    Command="{Binding ToggleColorCommand}"
                    Cursor="Hand"
                    DockPanel.Dock="Left"
                    Tag="color:swatch"
                    ToolTip="Pick a color: hue and brightness, see-through, the palette, and colors used lately">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{StaticResource Brush.Checker}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Small}">
                            <Border Background="{Binding ColorBrush}" CornerRadius="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <controls:CommitTextBox FontFamily="{StaticResource Font.Mono}" Text="{Binding ColorHex}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="Field.Vector" DataType="inspector:PropertyField">
        <ItemsControl ItemsSource="{Binding Axes, Mode=OneTime}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <!-- A 2D Transform hides Z (and a rotation's X and Y): those boxes go, and the rest share the row -->
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource Field.Visible}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="inspector:AxisField">
                    <controls:NumberField x:Name="Field" Margin="0,0,3,0" IsMixed="{Binding IsMixed, Mode=OneWay}" Label="{Binding ShownLabel, Mode=OneWay}" Value="{Binding Value}" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Label}" Value="X">
                            <Setter TargetName="Field" Property="LabelBrush" Value="{DynamicResource Brush.Axis.X}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Label}" Value="Y">
                            <Setter TargetName="Field" Property="LabelBrush" Value="{DynamicResource Brush.Axis.Y}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Label}" Value="Z">
                            <Setter TargetName="Field" Property="LabelBrush" Value="{DynamicResource Brush.Axis.Z}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <inspector:FieldTemplateSelector x:Key="FieldSelector"
                                     Bool="{StaticResource Field.Bool}"
                                     Color="{StaticResource Field.Color}"
                                     Custom="{StaticResource Field.Custom}"
                                     Entity="{StaticResource Field.Entity}"
                                     Named="{StaticResource Field.Name}"
                                     Enum="{StaticResource Field.Enum}"
                                     Lines="{StaticResource Field.Lines}"
                                     Number="{StaticResource Field.Number}"
                                     Image="{StaticResource Field.Image}"
                                     Sound="{StaticResource Field.Sound}"
                                     Text="{StaticResource Field.Text}"
                                     Vector="{StaticResource Field.Vector}" />

</ResourceDictionary>
