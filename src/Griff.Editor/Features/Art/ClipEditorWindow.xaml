<controls:ChromeWindow x:Class="Griff.Editor.Features.Art.ClipEditorWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:art="clr-namespace:Griff.Editor.Features.Art"
                       xmlns:controls="clr-namespace:Griff.Editor.Themes.Controls"
                       xmlns:converters="clr-namespace:Griff.Editor.Themes.Converters"
                       xmlns:theme="clr-namespace:Griff.Editor.Themes"
                       mc:Ignorable="d"
                       d:DataContext="{d:DesignInstance Type=art:ClipEditor}"
                       Title="Clip Editor"
                       Width="1100"
                       Height="700"
                       MinWidth="880"
                       MinHeight="540"
                       ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="Visible" />

        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Overline}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Tool" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Surface.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Whose clips these are -->
        <DockPanel Margin="16,12,16,0">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="Clips of" />
            <TextBlock x:Name="EntityName" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding EntityName}" />
        </DockPanel>

        <!-- Why there's nothing (or not everything) to show -->
        <Border x:Name="NoticeBar"
                Grid.Row="1"
                Margin="16,8,16,0"
                Padding="10,6"
                Background="{DynamicResource Brush.Surface.Document}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Medium}"
                Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button x:Name="AddAnimationButton"
                        Margin="8,0,0,0"
                        Command="{Binding AddAnimationCommand}"
                        Content="Add Animation"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Small}"
                        Visibility="{Binding CanAddAnimation, Converter={StaticResource Visible}}" />
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Status.Info}" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Info}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Notice}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,12,16,14" Visibility="{Binding HasAnimation, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- The frame's hitboxes and hurtboxes -->
            <DockPanel x:Name="BoxesPanel" Grid.Column="4" IsEnabled="{Binding CanEditBoxes}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Boxes" />
                <UniformGrid x:Name="BoxTools" Columns="3" DockPanel.Dock="Top">
                    <RadioButton x:Name="SelectTool" Content="Select" GroupName="BoxTool" IsChecked="{Binding IsSelectTool}" Style="{StaticResource Tool}" ToolTip="Pick a box to move it, or drag its corners (S)" />
                    <RadioButton x:Name="HitboxTool" Content="Hitbox" GroupName="BoxTool" IsChecked="{Binding IsHitboxTool}" Style="{StaticResource Tool}" ToolTip="Drag over the picture to draw a hitbox: where it hits (H)" />
                    <RadioButton x:Name="HurtboxTool" Content="Hurtbox" GroupName="BoxTool" IsChecked="{Binding IsHurtboxTool}" Style="{StaticResource Tool}" ToolTip="Drag over the picture to draw a hurtbox: where it can be hit (U)" />
                </UniformGrid>
                <CheckBox x:Name="CirclesBox" Margin="0,6,0,0" Content="Draw circles" DockPanel.Dock="Top" IsChecked="{Binding DrawCircles}" ToolTip="Draw circles instead of boxes (C)" />
                <CheckBox x:Name="OnionBox" Margin="0,4,0,0" Content="Onion skin" DockPanel.Dock="Top" IsChecked="{Binding OnionSkin}" ToolTip="Show the frame before, and its boxes, faintly underneath (O)" />
                <Button x:Name="CopyPreviousButton"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CopyPreviousFrameCommand}"
                        Content="Copy From Previous Frame"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Small}"
                        ToolTip="Give this frame the boxes of the frame before it (Ctrl+D)" />
                <TextBlock x:Name="BoxesSummary" Margin="0,4,0,6" DockPanel.Dock="Top" Style="{StaticResource Style.Text.Secondary}" Text="{Binding BoxesSummary}" TextWrapping="Wrap" />

                <!-- The box picked -->
                <StackPanel x:Name="BoxSettings" Margin="0,8,0,0" DockPanel.Dock="Bottom" Visibility="{Binding HasSelectedBox, Converter={StaticResource Visible}}">
                    <TextBlock x:Name="BoxLabel" Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding SelectedBox.Label}" TextWrapping="Wrap" />
                    <StackPanel x:Name="HitSettings" Visibility="{Binding IsHitboxSelected, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Width="80" VerticalAlignment="Center" Text="Damage" />
                            <controls:CommitTextBox x:Name="DamageBox" Text="{Binding BoxDamage, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Hit points it takes, before the hurtbox multiplies it" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Width="80" VerticalAlignment="Center" Text="Knockback" />
                            <controls:CommitTextBox x:Name="KnockbackYBox" Width="56" DockPanel.Dock="Right" Text="{Binding BoxKnockbackY, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Up, in units a second" />
                            <controls:CommitTextBox x:Name="KnockbackXBox" Margin="0,0,4,0" Text="{Binding BoxKnockbackX, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Away, in units a second" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Width="80" VerticalAlignment="Center" Text="Stun" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Style.Text.Secondary}" Text="frames" />
                            <controls:CommitTextBox x:Name="StunBox" Text="{Binding BoxStun, UpdateSourceTrigger=LostFocus}" ToolTip="Steps of hitstun (frames, at 60 a second)" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Width="80" VerticalAlignment="Center" Text="Group" />
                            <controls:CommitTextBox x:Name="GroupBox" Text="{Binding BoxGroup, UpdateSourceTrigger=LostFocus}" ToolTip="A swing hits each thing once per group" />
                        </DockPanel>
                    </StackPanel>
                    <DockPanel x:Name="HurtSettings" Margin="0,0,0,4" Visibility="{Binding IsHurtboxSelected, Converter={StaticResource Visible}}">
                        <TextBlock Width="80" VerticalAlignment="Center" Text="Multiplier" />
                        <controls:CommitTextBox x:Name="MultiplierBox" Text="{Binding BoxMultiplier, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" ToolTip="Hits here deal this many times their damage: 1.5 for a head" />
                    </DockPanel>
                    <Button x:Name="RemoveBoxButton" Margin="0,4,0,0" HorizontalAlignment="Left" Command="{Binding RemoveBoxCommand}" Style="{StaticResource Small}" ToolTip="Remove this box (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                            <TextBlock Text="Remove Box" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox x:Name="BoxList" ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="art:FrameBoxRow">
                            <DockPanel Margin="2,3">
                                <Border x:Name="Swatch" Width="10" Height="10" Margin="0,3,6,0" VerticalAlignment="Top" Background="#4DA3FF" CornerRadius="2" DockPanel.Dock="Left" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding Place}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHit}" Value="True">
                                    <Setter TargetName="Swatch" Property="Background" Value="#FF4D54" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The clips -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Clips" />
                <WrapPanel x:Name="ClipButtons" Margin="0,8,0,0" DockPanel.Dock="Bottom">
                    <Button x:Name="AddClipButton" Command="{Binding AddClipCommand}" Style="{StaticResource Small}" ToolTip="Add a clip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Add}" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RenameClipButton" Command="{Binding RenameClipCommand}" Content="Rename" Style="{StaticResource Small}" ToolTip="Rename this clip (F2)" />
                    <Button x:Name="RemoveClipButton" Command="{Binding RemoveClipCommand}" Style="{StaticResource Small}" ToolTip="Remove this clip (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Delete}" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartWithButton" Command="{Binding StartWithClipCommand}" Content="Start With This" Style="{StaticResource Small}" ToolTip="Make this the clip the game starts playing" />
                </WrapPanel>
                <ListBox x:Name="ClipList" ItemsSource="{Binding Clips}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="art:ClipRow">
                            <StackPanel Margin="2,3">
                                <DockPanel>
                                    <Border x:Name="StartTag"
                                            Padding="5,0"
                                            Background="{DynamicResource Brush.Accent}"
                                            CornerRadius="{StaticResource Radius.Small}"
                                            DockPanel.Dock="Right"
                                            ToolTip="The game starts playing this"
                                            Visibility="Collapsed">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.OnAccent}" Text="starts" />
                                    </Border>
                                    <TextBlock x:Name="ClipName" FontWeight="SemiBold" Text="{Binding Name}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding Summary}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsStart}" Value="True">
                                    <Setter TargetName="StartTag" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOwnFrames}" Value="True">
                                    <Setter TargetName="ClipName" Property="FontStyle" Value="Italic" />
                                    <Setter TargetName="ClipName" Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The clip playing -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Preview" />

                <!-- Its speed and looping -->
                <DockPanel x:Name="Settings" Margin="0,0,0,8" DockPanel.Dock="Top">
                    <TextBlock VerticalAlignment="Center" Text="Speed" />
                    <TextBox x:Name="SpeedBox"
                             Width="56"
                             Margin="8,0,4,0"
                             VerticalAlignment="Center"
                             KeyDown="OnSpeedKeyDown"
                             Text="{Binding Speed, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                             ToolTip="Frames a second (0 holds the first frame)" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Style.Text.Secondary}" Text="fps" />
                    <CheckBox x:Name="LoopBox" Margin="16,0,0,0" VerticalAlignment="Center" Content="Loops" IsChecked="{Binding Loops}" ToolTip="Loop, or play once and stop on the last frame" />
                    <TextBlock x:Name="SettingsNote"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Style.Text.Secondary}"
                               Text="{Binding SettingsNote}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SettingsNote}" />
                </DockPanel>

                <!-- The sprite sheet, to pick its frames from -->
                <DockPanel x:Name="SheetPanel" Margin="0,10,0,0" DockPanel.Dock="Bottom">
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Heading}" Text="Sheet" />
                        <TextBlock Margin="10,0,0,6"
                                   VerticalAlignment="Bottom"
                                   Style="{StaticResource Style.Text.Secondary}"
                                   Text="Drag across frames to play them; Shift-click to stretch to a frame."
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SheetGrid"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      ItemsSource="{Binding Sheet}"
                                      MouseLeftButtonDown="OnSheetDown"
                                      MouseLeftButtonUp="OnSheetUp"
                                      MouseMove="OnSheetMove"
                                      LostMouseCapture="OnSheetLostCapture">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top" Columns="{Binding SheetColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="art:SheetCell">
                                    <Border x:Name="Cell"
                                            Width="48"
                                            Height="54"
                                            Margin="0,0,3,3"
                                            Background="{DynamicResource Brush.Surface.Document}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Small}"
                                            ToolTip="{Binding Index}"
                                            ToolTipService.InitialShowDelay="600">
                                        <DockPanel>
                                            <TextBlock x:Name="Number" Margin="0,0,0,1" HorizontalAlignment="Center" DockPanel.Dock="Bottom" FontSize="11" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding Index}" />
                                            <Image Margin="5,5,5,1" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Image}" Stretch="Uniform" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding InClip}" Value="True">
                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
                                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Its frames -->
                <ScrollViewer Margin="0,8,0,0" DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FrameStrip" ItemsSource="{Binding Frames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="art:ClipFrame">
                                <Button Width="56"
                                        Height="66"
                                        Margin="0,0,4,4"
                                        Command="{Binding DataContext.ShowFrameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Show this frame">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Cell"
                                                    Background="{DynamicResource Brush.Surface.Document}"
                                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Small}">
                                                <DockPanel>
                                                    <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center" DockPanel.Dock="Bottom" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding SheetFrame}" />
                                                    <Image Margin="6,6,6,2" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Image}" Stretch="Uniform" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Play, pause and step through it -->
                <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                    <Button x:Name="StepBackButton" Command="{Binding StepBackCommand}" Style="{StaticResource Style.Button.Toolbar}" ToolTip="Back a frame (Left)">
                        <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Step}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="PlayButton" Margin="2,0" Command="{Binding PlayCommand}" Style="{StaticResource Style.Button.Toolbar}" ToolTip="Play or pause (Space)">
                        <TextBlock x:Name="PlayIcon">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Icon}">
                                    <Setter Property="Text" Value="{x:Static theme:Icons.Play}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="{x:Static theme:Icons.Pause}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="StepForwardButton" Command="{Binding StepForwardCommand}" Style="{StaticResource Style.Button.Toolbar}" ToolTip="On a frame (Right)">
                        <TextBlock Style="{StaticResource Style.Icon}" Text="{x:Static theme:Icons.Step}" />
                    </Button>
                    <TextBlock x:Name="FrameText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding FrameText}" />
                </DockPanel>

                <Border x:Name="Preview"
                        Background="{DynamicResource Brush.Surface.Document}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}">
                    <!-- The frame (over the one before, with onion skin), and its boxes drawn over it -->
                    <Grid x:Name="PreviewArea" Margin="16">
                        <Image x:Name="OnionImage"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.3"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="{Binding OnionImage}"
                               Stretch="Uniform" />
                        <Image x:Name="PreviewImage"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="{Binding FrameImage}"
                               Stretch="Uniform" />
                        <Canvas x:Name="BoxCanvas"
                                Background="Transparent"
                                ClipToBounds="True"
                                LostMouseCapture="OnBoxesLostCapture"
                                MouseLeftButtonDown="OnBoxesDown"
                                MouseLeftButtonUp="OnBoxesUp"
                                MouseMove="OnBoxesMove" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</controls:ChromeWindow>
